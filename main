local ThemeOrder = { "Onyx", "Light", "Dark", "Bone", "Catppuccin Latte", "Catppuccin Frappe", "Catppuccin Macchiato", "Catppuccin Mocha", "Reverse Onyx" }

local themeBinds, themeFns, corners = {}, {}, {}
local square = false
local currentTheme = Themes.Onyx

local function T(key)
	return Color3.fromHex(currentTheme[key])
end

local function bind(inst, prop, key)
	themeBinds[#themeBinds + 1] = { inst, prop, key }
	inst[prop] = T(key)
	return inst
end

local function onTheme(fn)
	themeFns[#themeFns + 1] = fn
	fn()
end

local function corner(inst, r, fixed)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, (square and not fixed) and 0 or r)
	c.Parent = inst
	if not fixed then corners[#corners + 1] = { c, r } end
	return c
end

local function stroke(inst, key, thickness)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness or 1
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = inst
	bind(s, "Color", key or "Border")
	return s
end

local function setSquare(v)
	square = v
	local alive = {}
	for _, e in ipairs(corners) do
		if e[1].Parent then
			alive[#alive + 1] = e
			e[1].CornerRadius = UDim.new(0, v and 0 or e[2])
		end
	end
	corners = alive
end

local function applyTheme(name)
	local th = Themes[name]
	if not th then return end
	currentTheme = th
	S.Theme = name
	local alive = {}
	for _, b in ipairs(themeBinds) do
		if b[1].Parent then
			alive[#alive + 1] = b
			tween(b[1], { [b[2]] = T(b[3]) }, 0.25)
		end
	end
	themeBinds = alive
	for _, fn in ipairs(themeFns) do pcall(fn) end
end

local F = Enum.Font
local orderCounter = setmetatable({}, { __mode = "k" })

local function New(class, props)
	local o = Instance.new(class)
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then parent = v else o[k] = v end
	end
	if parent then
		if o:IsA("GuiObject") and not (props and props.LayoutOrder) then
			local n = (orderCounter[parent] or 0) + 1
			orderCounter[parent] = n
			o.LayoutOrder = n
		end
		o.Parent = parent
	end
	return o
end

local function Pad(parent, l, t, r, b)
	return New("UIPadding", { PaddingLeft = UDim.new(0, l), PaddingTop = UDim.new(0, t), PaddingRight = UDim.new(0, r), PaddingBottom = UDim.new(0, b), Parent = parent })
end

local function Frame(parent, key, props)
	local f = New("Frame", { BorderSizePixel = 0, Parent = parent })
	if key then bind(f, "BackgroundColor3", key) else f.BackgroundTransparency = 1 end
	if props then for k, v in pairs(props) do f[k] = v end end
	return f
end

local function Text(parent, text, size, key, font, props)
	local l = New("TextLabel", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Text = text, TextSize = size or 13, Font = font or F.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, (size or 13) + 4), Parent = parent,
	})
	bind(l, "TextColor3", key or "Text")
	if props then for k, v in pairs(props) do l[k] = v end end
	return l
end

local function Button(parent, text, w, h, kind, props)
	local b = New("TextButton", { AutoButtonColor = false, BorderSizePixel = 0, Text = text, Font = F.GothamMedium, TextSize = 13, Size = UDim2.fromOffset(w or 90, h or 30), Parent = parent })
	if kind then
		if kind == "danger" then
			bind(b, "BackgroundColor3", "Bad")
			b.TextColor3 = Color3.new(1, 1, 1)
		else
			bind(b, "BackgroundColor3", "Accent")
			bind(b, "TextColor3", "OnAccent")
		end
		b.MouseEnter:Connect(function() tween(b, { BackgroundTransparency = 0.15 }, 0.12) end)
		b.MouseLeave:Connect(function() tween(b, { BackgroundTransparency = 0 }, 0.12) end)
	else
		bind(b, "BackgroundColor3", "Surface2")
		bind(b, "TextColor3", "Text")
		stroke(b, "Border")
		b.MouseEnter:Connect(function() tween(b, { BackgroundColor3 = T("Border") }, 0.12) end)
		b.MouseLeave:Connect(function() tween(b, { BackgroundColor3 = T("Surface2") }, 0.12) end)
	end
	corner(b, 6)
	if props then for k, v in pairs(props) do b[k] = v end end
	return b
end

local function Card(parent, h)
	local c = Frame(parent, "Surface", { Size = UDim2.new(1, 0, 0, h or 0) })
	if not h then c.AutomaticSize = Enum.AutomaticSize.Y end
	corner(c, 8)
	stroke(c, "Border")
	return c
end

local function Section(parent, text)
	return Text(parent, string.upper(text), 11, "Sub", F.GothamBold, { Size = UDim2.new(1, 0, 0, 22), TextYAlignment = Enum.TextYAlignment.Bottom })
end

local function RowCard(parent, title, sub)
	local c = Card(parent, sub and 52 or 44)
	Text(c, title, 13, "Text", F.GothamMedium, {
		Position = UDim2.fromOffset(14, sub and 8 or 0), Size = UDim2.new(1, -170, 0, sub and 18 or 44),
		TextYAlignment = sub and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
	})
	if sub then
		Text(c, sub, 11, "Sub", F.Gotham, { Position = UDim2.fromOffset(14, 27), Size = UDim2.new(1, -170, 0, 16) })
	end
	return c
end

local switchCorners, squareSwitches = {}, false
local function switchCorner(inst, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, squareSwitches and 0 or r)
	c.Parent = inst
	switchCorners[#switchCorners + 1] = { c, r }
	return c
end
local function setSquareSwitches(v)
	squareSwitches = v and true or false
	local alive = {}
	for _, e in ipairs(switchCorners) do
		if e[1].Parent then
			alive[#alive + 1] = e
			e[1].CornerRadius = UDim.new(0, squareSwitches and 0 or e[2])
		end
	end
	switchCorners = alive
end

local function Toggle(parent, title, sub, default, cb)
	local c = RowCard(parent, title, sub)
	local sw = New("Frame", { BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), Size = UDim2.fromOffset(40, 20), Parent = c })
	switchCorner(sw, 10)
	local knob = New("Frame", { BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.fromOffset(16, 16), Parent = sw })
	switchCorner(knob, 8)
	local state = default and true or false
	local function render(anim)
		local bg = state and T("Accent") or T("Border")
		local pos = state and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
		local kc = state and T("OnAccent") or T("Sub")
		if anim then
			tween(sw, { BackgroundColor3 = bg }, 0.15)
			tween(knob, { Position = pos, BackgroundColor3 = kc }, 0.15)
		else
			sw.BackgroundColor3 = bg
			knob.Position = pos
			knob.BackgroundColor3 = kc
		end
	end
	onTheme(function() render(false) end)
	local hit = New("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = c })
	hit.MouseButton1Click:Connect(function()
		state = not state
		render(true)
		cb(state)
	end)
	return {
		Set = function(v) state = v and true or false; render(true); cb(state) end,
		Get = function() return state end,
	}
end

local function Slider(parent, title, minV, maxV, default, fmt, cb)
	local c = Card(parent, 56)
	Text(c, title, 13, "Text", F.GothamMedium, { Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -100, 0, 18) })
	local val = Text(c, "", 12, "Sub", F.Gotham, { Position = UDim2.new(1, -14, 0, 8), AnchorPoint = Vector2.new(1, 0), Size = UDim2.fromOffset(80, 18), TextXAlignment = Enum.TextXAlignment.Right })
	local track = Frame(c, "Border", { Position = UDim2.new(0, 14, 1, -18), Size = UDim2.new(1, -28, 0, 6) })
	corner(track, 3, true)
	local fill = Frame(track, "Accent", { Size = UDim2.fromScale(0, 1) })
	corner(fill, 3, true)
	local knob = Frame(track, "Text", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(14, 14) })
	corner(knob, 7, true)
	local hit = New("TextButton", { Text = "", BackgroundTransparency = 1, Position = UDim2.new(0, 14, 1, -30), Size = UDim2.new(1, -28, 0, 30), Parent = c })
	local value = default
	local function render()
		local r = (value - minV) / (maxV - minV)
		fill.Size = UDim2.fromScale(r, 1)
		knob.Position = UDim2.fromScale(r, 0.5)
		val.Text = fmt(value)
	end
	local dragging = false
	local function setX(x)
		local r = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		value = minV + (maxV - minV) * r
		render()
		cb(value)
	end
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setX(i.Position.X)
		end
	end)
	connect(UserInputService.InputChanged, function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			setX(i.Position.X)
		end
	end)
	connect(UserInputService.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	render()
	return {
		Set = function(v) value = math.clamp(v, minV, maxV); render(); cb(value) end,
		Get = function() return value end,
	}
end

local function Input(parent, placeholder, w, h)
	local b = New("TextBox", {
		BorderSizePixel = 0, ClearTextOnFocus = false, Text = "", PlaceholderText = placeholder, Font = F.Gotham, TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.fromOffset(w or 160, h or 30), Parent = parent,
	})
	bind(b, "BackgroundColor3", "Surface2")
	bind(b, "TextColor3", "Text")
	bind(b, "PlaceholderColor3", "Sub")
	corner(b, 6)
	stroke(b, "Border")
	Pad(b, 8, 0, 8, 0)
	return b
end

local guiRef
local function keepOnScreen(target)
	if not guiRef then return end
	local p, s, vp = target.AbsolutePosition, target.AbsoluteSize, guiRef.AbsoluteSize
	local dx, dy = 0, 0
	if s.X <= vp.X then
		if p.X < 0 then dx = -p.X elseif p.X + s.X > vp.X then dx = vp.X - (p.X + s.X) end
	end
	if s.Y <= vp.Y then
		if p.Y < 0 then dy = -p.Y elseif p.Y + s.Y > vp.Y then dy = vp.Y - (p.Y + s.Y) end
	end
	if dx ~= 0 or dy ~= 0 then
		local pos = target.Position
		target.Position = UDim2.new(pos.X.Scale, pos.X.Offset + dx, pos.Y.Scale, pos.Y.Offset + dy)
	end
end

local function draggable(handle, target, clamp, canDrag)
	local dragging, dragStart, startPos = false, nil, nil
	handle.InputBegan:Connect(function(i)
		if canDrag and not canDrag() then return end
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging, dragStart, startPos = true, i.Position, target.Position
		end
	end)
	connect(UserInputService.InputChanged, function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - dragStart
			target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			if clamp then keepOnScreen(target) end
		end
	end)
	connect(UserInputService.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

local Icons = {}
do
	local function make(parent, size, key)
		local root = New("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromOffset(size, size), Parent = parent })
		local ic = { Root = root, parts = {}, k = size / 24, key = key or "Sub" }
		function ic.Tint(k2)
			for _, p in ipairs(ic.parts) do tween(p[1], { [p[2]] = T(k2) }, 0.12) end
		end
		return ic
	end
	local function seg(ic, x1, y1, x2, y2, th)
		local k = ic.k
		local dx, dy = (x2 - x1) * k, (y2 - y1) * k
		local len = math.sqrt(dx * dx + dy * dy)
		local t = math.max(1.2, (th or 2) * k)
		local f = New("Frame", {
			BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset((x1 + x2) / 2 * k, (y1 + y2) / 2 * k),
			Size = UDim2.fromOffset(len + t * 0.6, t), Rotation = math.deg(math.atan2(dy, dx)), Parent = ic.Root,
		})
		corner(f, 99, true)
		bind(f, "BackgroundColor3", ic.key)
		ic.parts[#ic.parts + 1] = { f, "BackgroundColor3" }
	end
	local function box(ic, x, y, w, h, r, th)
		local k = ic.k
		local f = New("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(x * k, y * k), Size = UDim2.fromOffset(w * k, h * k), Parent = ic.Root })
		corner(f, r * k, true)
		local s = Instance.new("UIStroke")
		s.Thickness = math.max(1, (th or 2) * k)
		s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		s.Parent = f
		bind(s, "Color", ic.key)
		ic.parts[#ic.parts + 1] = { s, "Color" }
	end
	local function poly(ic, pts, th)
		for i = 1, #pts - 1 do seg(ic, pts[i][1], pts[i][2], pts[i + 1][1], pts[i + 1][2], th) end
	end

	function Icons.trash(parent, size, key)
		local ic = make(parent, size, key)
		seg(ic, 4, 7, 20, 7)
		poly(ic, { { 9, 7 }, { 9, 3.5 }, { 15, 3.5 }, { 15, 7 } }, 1.8)
		box(ic, 6, 9, 12, 12, 2.5, 1.8)
		seg(ic, 10, 12.5, 10, 17.5, 1.6)
		seg(ic, 14, 12.5, 14, 17.5, 1.6)
		return ic
	end
	function Icons.copy(parent, size, key)
		local ic = make(parent, size, key)
		box(ic, 9, 9, 11, 11, 2.5, 1.8)
		poly(ic, { { 9, 4 }, { 4.5, 4 }, { 4.5, 15 }, { 9, 15 } }, 1.8)
		seg(ic, 9, 4, 15, 4, 1.8)
		seg(ic, 15, 4, 15, 9, 1.8)
		return ic
	end
	function Icons.bolt(parent, size, key)
		local ic = make(parent, size, key)
		poly(ic, { { 13, 2 }, { 3, 14 }, { 12, 14 }, { 11, 22 }, { 21, 10 }, { 12, 10 }, { 13, 2 } }, 2)
		return ic
	end
	function Icons.plus(parent, size, key)
		local ic = make(parent, size, key)
		seg(ic, 12, 5, 12, 19)
		seg(ic, 5, 12, 19, 12)
		return ic
	end
	function Icons.x(parent, size, key)
		local ic = make(parent, size, key)
		seg(ic, 6, 6, 18, 18)
		seg(ic, 18, 6, 6, 18)
		return ic
	end
	function Icons.play(parent, size, key)
		local ic = make(parent, size, key)
		poly(ic, { { 8, 5 }, { 8, 19 }, { 19, 12 }, { 8, 5 } }, 2.2)
		seg(ic, 8.5, 8, 8.5, 16, 3)
		seg(ic, 10, 9, 10, 15, 3)
		return ic
	end
	function Icons.search(parent, size, key)
		local ic = make(parent, size, key)
		box(ic, 4, 4, 12, 12, 6, 2)
		seg(ic, 15.5, 15.5, 20, 20)
		return ic
	end
	function Icons.reload(parent, size, key)
		local ic = make(parent, size, key)
		local cx, cy, r = 12, 12, 7.5
		local pts = {}
		for a = 40, 320, 20 do
			local rad = math.rad(a)
			pts[#pts + 1] = { cx + r * math.cos(rad), cy + r * math.sin(rad) }
		end
		poly(ic, pts, 2)

		local ea = math.rad(320)
		local ex, ey = cx + r * math.cos(ea), cy + r * math.sin(ea)
		local tx, ty = -math.sin(ea), math.cos(ea)
		local tipX, tipY = ex + tx * 2.5, ey + ty * 2.5
		for _, ang in ipairs({ 0.65, -0.65 }) do
			local c, s2 = math.cos(ang), math.sin(ang)
			local bx, by = -(tx * c - ty * s2), -(tx * s2 + ty * c)
			seg(ic, tipX, tipY, tipX + bx * 5.5, tipY + by * 5.5, 2)
		end
		return ic
	end
	function Icons.chevUp(parent, size, key)
		local ic = make(parent, size, key)
		poly(ic, { { 6, 15 }, { 12, 9 }, { 18, 15 } })
		return ic
	end
	function Icons.chevDown(parent, size, key)
		local ic = make(parent, size, key)
		poly(ic, { { 6, 9 }, { 12, 15 }, { 18, 9 } })
		return ic
	end
end

local function IconButton(parent, kind, boxSize, iconSize, hoverKey, props)
	local b = New("TextButton", { AutoButtonColor = false, BorderSizePixel = 0, Text = "", BackgroundTransparency = 1, Size = UDim2.fromOffset(boxSize, boxSize), Parent = parent })
	bind(b, "BackgroundColor3", "Surface2")
	corner(b, 6)
	local ic = Icons[kind](b, iconSize or 14, "Sub")
	ic.Root.AnchorPoint = Vector2.new(0.5, 0.5)
	ic.Root.Position = UDim2.fromScale(0.5, 0.5)
	b.MouseEnter:Connect(function() b.BackgroundTransparency = 0; ic.Tint(hoverKey or "Text") end)
	b.MouseLeave:Connect(function() b.BackgroundTransparency = 1; ic.Tint("Sub") end)
	if props then for k, v in pairs(props) do b[k] = v end end
	return b, ic
end

local gui = Instance.new("ScreenGui")
gui.Name = "Monarchy"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.DisplayOrder = 999999
