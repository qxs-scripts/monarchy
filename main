	local function typeColor(ty)
		if ty == "Error" then return T("Bad") elseif ty == "Warning" then return Color3.fromHex(currentTheme.Syn.Builtin) elseif ty == "Info" then return T("Accent") end
		return T("Text")
	end
	local function visible(e) return filter == "All" or e.ty == filter end
	local function makeRow(e)
		local stamp = '<font color="#' .. T("Sub"):ToHex() .. '">' .. e.time .. "</font>  "
		return New("TextLabel", {
			BackgroundTransparency = 1, BorderSizePixel = 0, RichText = true, Font = F.Code, TextSize = 12, TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y, TextColor3 = typeColor(e.ty), Text = stamp .. Lex.escape(e.msg), Parent = cBody,
		})
	end
	local function makeNote(text)
		return New("TextLabel", { BackgroundTransparency = 1, BorderSizePixel = 0, Font = F.Gotham, TextSize = 12, TextColor3 = T("Sub"), Text = text, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 18), Parent = cBody })
	end
	local function scrollBottom()
		task.defer(function() cBody.CanvasPosition = Vector2.new(0, 1e6) end)
	end
	local function updateCounts()
		tabConsole.Text = "Console " .. #entries
		tabProblems.Text = "Problems " .. #problems
		local onC = consoleTab == "Console"
		tabConsole.TextColor3 = onC and T("Text") or T("Sub")
		tabProblems.TextColor3 = onC and T("Sub") or T("Text")
		barConsole.Visible = onC
		barProblems.Visible = not onC
		for _, c in ipairs(chips) do
			local on = c[2] == filter
			c[1].Visible = onC
			c[1].BackgroundColor3 = T("Surface2")
			c[1].BackgroundTransparency = on and 0 or 1
			c[1].TextColor3 = on and T("Text") or T("Sub")
		end
	end
	local function renderConsole()
		for _, r in ipairs(rows) do r:Destroy() end
		rows = {}
		if consoleTab == "Console" then
			for _, e in ipairs(entries) do
				if visible(e) then rows[#rows + 1] = makeRow(e) end
			end
			if #rows == 0 then rows[1] = makeNote("No output yet.") end
		else
			for _, p in ipairs(problems) do
				rows[#rows + 1] = makeRow({ ty = "Error", time = p.line and ("Line " .. p.line) or "Error", msg = p.msg })
			end
			if #problems == 0 then rows[1] = makeNote("No problems detected.") end
		end
		updateCounts()
		scrollBottom()
	end

	local function pushLog(ty, msg)
		msg = tostring(msg)
		if #msg > 800 then msg = msg:sub(1, 800) .. "..." end
		local e = { ty = ty, msg = msg, time = os.date("%H:%M:%S") }
		entries[#entries + 1] = e
		local showing = consoleTab == "Console"
		if #entries > MAX_ENTRIES then
			local old = table.remove(entries, 1)
			if showing and visible(old) and rows[1] and rows[1]:IsA("TextLabel") and #rows > 0 then
				rows[1]:Destroy()
				table.remove(rows, 1)
			end
		end
		if showing then
			if visible(e) then
				local atBottom = cBody.CanvasPosition.Y >= cBody.AbsoluteCanvasSize.Y - cBody.AbsoluteWindowSize.Y - 10
				if #rows == 1 and rows[1].Text == "No output yet." then rows[1]:Destroy() rows = {} end
				rows[#rows + 1] = makeRow(e)
				if atBottom then scrollBottom() end
			end
			updateCounts()
		else
			tabConsole.Text = "Console " .. #entries
		end
	end
	connect(LogService.MessageOut, function(msg, mt) pushLog(MSG_TYPES[mt] or "Output", msg) end)

	tabConsole.MouseButton1Click:Connect(function() consoleTab = "Console" renderConsole() end)
	tabProblems.MouseButton1Click:Connect(function() consoleTab = "Problems" renderConsole() end)
	for _, c in ipairs(chips) do
		c[1].MouseButton1Click:Connect(function() filter = c[2] renderConsole() end)
	end
	cClear.MouseButton1Click:Connect(function()
		if consoleTab == "Console" then entries = {} else problems = {} end
		renderConsole()
	end)
	cCopy.MouseButton1Click:Connect(function()
		local lines = {}
		if consoleTab == "Console" then
			for _, e in ipairs(entries) do if visible(e) then lines[#lines + 1] = "[" .. e.time .. "] " .. e.msg end end
		else
			for _, p in ipairs(problems) do lines[#lines + 1] = (p.line and ("Line " .. p.line .. ": ") or "") .. p.msg end
		end
		if #lines == 0 then notify("Nothing to copy.", "error") return end
		if copy(table.concat(lines, "\n")) then notify("Copied " .. consoleTab:lower() .. " to the clipboard.", "success")
		else notify("Your executor doesn't support clipboard access.", "error") end
	end)

	local grip = New("TextButton", { AutoButtonColor = false, BorderSizePixel = 0, BackgroundTransparency = 1, Text = "", Size = UDim2.new(1, 0, 0, 10), ZIndex = 5, Parent = left })
	local gripPill = Frame(grip, "Border", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 3), Size = UDim2.fromOffset(36, 3), ZIndex = 5 })
	corner(gripPill, 2, true)
	local gripActive = false
	grip.MouseEnter:Connect(function() if not gripActive then tween(gripPill, { BackgroundColor3 = T("Sub") }, 0.12) end end)
	grip.MouseLeave:Connect(function() if not gripActive then tween(gripPill, { BackgroundColor3 = T("Border") }, 0.12) end end)

	local statusToggleIc, statusToggleLbl
	local function maxConsoleH()
		local ph = exec.AbsoluteSize.Y / math.max(uiscale.Scale, 0.01)
		if ph < 100 then ph = PAGE_H end
		return math.max(CONSOLE_MIN, ph - EDITOR_Y - STATUS_H - 12 - EDITOR_MIN)
	end
	local function relayout()
		consoleH = math.clamp(consoleH, CONSOLE_MIN, maxConsoleH())
		console.Size = UDim2.new(1, 0, 0, consoleH)
		console.Visible = consoleOpen
		grip.Visible = consoleOpen
		grip.Position = UDim2.new(0, 0, 1, -(STATUS_H + 6 + consoleH + 8))
		local bottom = STATUS_H + 6 + (consoleOpen and (consoleH + 6) or 0)
		editorHolder.Size = UDim2.new(1, 0, 1, -(EDITOR_Y + bottom))
		if statusToggleLbl then statusToggleLbl.TextColor3 = consoleOpen and T("Sub") or T("Accent") end
		if statusToggleLbl then statusToggleLbl.Text = consoleOpen and "Hide console" or "Show console" end
	end
	local function setConsoleOpen(v)
		consoleOpen = v
		relayout()
		if v then renderConsole() end
	end
	local dragY, dragH = 0, 0
	grip.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			gripActive, dragY, dragH = true, i.Position.Y, consoleH
			gripPill.BackgroundColor3 = T("Accent")
		end
	end)
	connect(UserInputService.InputChanged, function(i)
		if gripActive and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			consoleH = dragH - (i.Position.Y - dragY) / math.max(uiscale.Scale, 0.01)
			relayout()
		end
	end)
	connect(UserInputService.InputEnded, function(i)
		if gripActive and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
			gripActive = false
			tween(gripPill, { BackgroundColor3 = T("Border") }, 0.15)
		end
	end)
	cClose.MouseButton1Click:Connect(function() setConsoleOpen(false) end)

	local status = Frame(left, nil, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, STATUS_H) })
	local dot = Frame(status, "Good", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0), Size = UDim2.fromOffset(6, 6) })
	corner(dot, 3, true)
	local statusToggle = New("TextButton", { AutoButtonColor = false, BorderSizePixel = 0, BackgroundTransparency = 1, Text = "", Position = UDim2.fromOffset(16, 0), Size = UDim2.fromOffset(100, STATUS_H), Parent = status })
	statusToggleIc = Icons.chevUp(statusToggle, 12, "Sub")
	statusToggleIc.Root.AnchorPoint = Vector2.new(0, 0.5)
	statusToggleIc.Root.Position = UDim2.new(0, 0, 0.5, 0)
	statusToggleLbl = Text(statusToggle, "Hide console", 11, "Sub", F.GothamMedium, { Position = UDim2.fromOffset(15, 0), Size = UDim2.new(1, -15, 1, 0) })
	statusToggle.MouseButton1Click:Connect(function() setConsoleOpen(not consoleOpen) end)
	local statusPos = Text(status, "Ln 1, Col 1   ·   Spaces: 4   ·   Luau", 11, "Sub", F.Gotham, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(220, STATUS_H), TextXAlignment = Enum.TextXAlignment.Right })
	local function updateStatus()
		local col, line = caretColLine()
		if col then statusPos.Text = ("Ln %d, Col %d   ·   Spaces: 4   ·   Luau"):format((line or 0) + 1, col + 1) end
	end
	connect(box:GetPropertyChangedSignal("CursorPosition"), updateStatus)
	connect(box:GetPropertyChangedSignal("Text"), updateStatus)

	local checkToken = 0
	local function parseErr(err)
		err = tostring(err)
		local ln, msg = err:match(":(%d+):%s*(.*)$")
		return { line = tonumber(ln), msg = msg or err }
	end
	local function checkSyntax()
		local list = {}
		local code = box.Text
		if loadstring and #code <= 60000 and trim(code) ~= "" then
			local ok, fn, err = pcall(loadstring, code)
			if ok and not fn and err then list[1] = parseErr(err) end
		end
		problems = list
		if consoleTab == "Problems" then renderConsole() else updateCounts() end
	end
	connect(box:GetPropertyChangedSignal("Text"), function()
		checkToken += 1
		local my = checkToken
		task.delay(0.7, function() if my == checkToken then checkSyntax() end end)
	end)

	connect(editorHolder:GetPropertyChangedSignal("AbsoluteSize"), layout)
	onTheme(function() renderConsole() end)
	relayout()
	pushLog("Info", "Monarchy " .. VERSION .. " console ready.")

	local function execute()
		local code = box.Text
		if trim(code) == "" then notify("Nothing to execute.", "error") return end
		if not loadstring then notify("loadstring isn't available in this environment.", "error") return end
		local fn, err = loadstring(code)
		if not fn then
			problems = { parseErr(err) }
			pushLog("Error", "Syntax error: " .. tostring(err))
			if not consoleOpen then notify("Syntax error: " .. string.sub(tostring(err), 1, 160), "error") end
			return
		end
		problems = {}
		updateCounts()
		pushLog("Info", "Executing " .. (scripts[activeScript] and scripts[activeScript].name or "script") .. "...")
		task.spawn(function()
			local ok, e = pcall(fn)
			if ok then
				pushLog("Info", "Script executed.")
				if not consoleOpen then notify("Script executed.", "success") end
			else
				pushLog("Error", "Runtime error: " .. tostring(e))
				if not consoleOpen then notify("Runtime error: " .. string.sub(tostring(e), 1, 160), "error") end
			end
		end)
	end
	runBtn.MouseButton1Click:Connect(execute)

	function Exec.Get()
		saveCurrent()
		return scripts, activeScript
	end
	function Exec.Set(list, active)
		if type(list) ~= "table" or #list == 0 then return end
		local clean = {}
		for _, s in ipairs(list) do
			if type(s) == "table" then
				clean[#clean + 1] = { name = tostring(s.name or "Script"), code = tostring(s.code or "") }
			end
		end
		if #clean == 0 then return end
		scripts = clean
		activeScript = math.clamp(tonumber(active) or 1, 1, #scripts)
		loadActive()
		renderTabs()
	end
	function Exec.AddScript(name, code)
		saveCurrent()
		scripts[#scripts + 1] = { name = uniqueName(tostring(name or "Script")), code = tostring(code or "") }
		activeScript = #scripts
		loadActive()
		renderTabs()
	end
	function Exec.Refresh() refreshHighlight() end
	onTheme(refreshHighlight)

	setProgrammatic(scripts[1].code, nil)
	layout()
end

do
	local P = Pages["Script Hub"]
	local query, page, totalPages = "", 1, 1
	local fetchToken = 0
	local loadedOnce = false

	local topRow = Frame(P, nil, { Size = UDim2.new(1, 0, 0, 30) })
	local searchBox = Input(topRow, "Search ScriptBlox...", 300, 30)
	local searchBtn = Button(topRow, "Search", 80, 30, true, { Position = UDim2.fromOffset(308, 0) })
	local latestBtn = Button(topRow, "Latest", 80, 30, false, { Position = UDim2.fromOffset(396, 0) })

	local list = New("ScrollingFrame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 38), Size = UDim2.new(1, 0, 1, -76),
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 3,
		ScrollingDirection = Enum.ScrollingDirection.Y, Parent = P,
	})
	bind(list, "ScrollBarImageColor3", "Border")
	Pad(list, 0, 0, 8, 0)
	New("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })

	local bottom = Frame(P, nil, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 30) })
	local prevBtn = Button(bottom, "‹ Prev", 80, 30)
	local nextBtn = Button(bottom, "Next ›", 80, 30, false, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0) })
	local pageLbl = Text(bottom, "", 12, "Sub", F.GothamMedium, { Position = UDim2.fromOffset(88, 0), Size = UDim2.new(1, -176, 1, 0), TextXAlignment = Enum.TextXAlignment.Center })

	local function updatePageLabel()
		local what = query ~= "" and ('"' .. query .. '"  ·  ') or ""
		pageLbl.Text = what .. "Page " .. page .. " / " .. totalPages
	end

	local function clearList()
		for _, c in ipairs(list:GetChildren()) do
			if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then c:Destroy() end
		end
	end
	local function message(txt, kind)
		clearList()
		Text(list, txt, 13, kind == "bad" and "Bad" or "Sub", F.GothamMedium, { Size = UDim2.new(1, 0, 0, 60), TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center })
	end

	local function describe(s)
		local parts = {}
		local g = type(s.game) == "table" and s.game.name or nil
		parts[#parts + 1] = g or (s.isUniversal and "Universal" or "Unknown game")
		parts[#parts + 1] = tostring(s.views or 0) .. " views"
		if s.key then parts[#parts + 1] = "Key" end
		if s.isPatched then parts[#parts + 1] = "Patched" end
		if s.verified then parts[#parts + 1] = "Verified" end
		return table.concat(parts, "  ·  ")
	end

	local function getCode(s)
		if type(s.script) == "string" and s.script ~= "" then return s.script end
		local id = s.slug or s._id
		if not id then return nil end
		local raw = httpGet(SCRIPTBLOX_API .. "raw/" .. id)
		if raw and raw ~= "" and not raw:find("^%s*<") then
			local okj, j = pcall(function() return HttpService:JSONDecode(raw) end)
			if not (okj and type(j) == "table" and j.message) then return raw end
		end
		local body = httpGet(SCRIPTBLOX_API .. id)
		local ok, res = pcall(function() return HttpService:JSONDecode(body) end)
		if ok and type(res) == "table" and type(res.script) == "table" and type(res.script.script) == "string" then
			return res.script.script
		end
		return nil
	end

	local imageCache = {}
	local function getImage(s)
		local path = s.image
		if (type(path) ~= "string" or path == "") and type(s.game) == "table" then path = s.game.imageUrl end
		if type(path) ~= "string" or path == "" then return nil end
		local url = path:match("^https?://") and path or (SCRIPTBLOX_SITE .. (path:sub(1, 1) == "/" and "" or "/") .. path)
		if imageCache[url] ~= nil then return imageCache[url] or nil end
		imageCache[url] = false
		if not (FS.ok and getcustomasset) then return nil end
		local body = httpGet(url)
		if type(body) ~= "string" or body == "" or body:find("^%s*<") then return nil end
		local ext = url:match("%.(%w+)$") or "png"
		local file = "Monarchy/cache/" .. url:gsub("[^%w]", "_"):sub(-60) .. "." .. ext
		local ok, asset = pcall(function()
			if not isfolder("Monarchy") then makefolder("Monarchy") end
			if not isfolder("Monarchy/cache") then makefolder("Monarchy/cache") end
			writefile(file, body)
			return getcustomasset(file)
		end)
		if ok and asset and asset ~= "" then
			imageCache[url] = asset
			return asset
		end
		return nil
	end

	local descCache = {}
	local function getDescription(s)
		local id = s.slug or s._id
		if id and descCache[id] ~= nil then return descCache[id] end
		local d = s.description
		if (type(d) ~= "string" or d == "") and id then
			local body = httpGet(SCRIPTBLOX_API .. id)
			local ok, res = pcall(function() return HttpService:JSONDecode(body) end)
			if ok and type(res) == "table" and type(res.script) == "table" then
				d = res.script.description or res.script.features
			end
		end
		if type(d) == "string" then
			d = trim((d:gsub("<[^>]+>", ""):gsub("&amp;", "&"):gsub("&quot;", '"'):gsub("&#39;", "'")))
		end
		if type(d) ~= "string" or d == "" then d = "No description available." end
		if id then descCache[id] = d end
		return d
	end

	local function openScript(s)
		if modalOpen then return end
		modalOpen = true
		closeMenu()
		local overlay = New("TextButton", { Text = "", AutoButtonColor = false, BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.5, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 60, Parent = gui })
		local card = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(400, 380), BorderSizePixel = 0, BackgroundColor3 = T("Surface"), Active = true, Parent = overlay })
		corner(card, 10)
		New("UIStroke", { Color = T("Border"), Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = card })

		local imgHolder = New("Frame", { BorderSizePixel = 0, BackgroundColor3 = T("Surface2"), Position = UDim2.fromOffset(16, 16), Size = UDim2.new(1, -32, 0, 120), ClipsDescendants = true, Parent = card })
		corner(imgHolder, 8)
		local img = New("ImageLabel", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ScaleType = Enum.ScaleType.Crop, Image = "", Visible = false, Parent = imgHolder })
		local imgNote = New("TextLabel", { BackgroundTransparency = 1, Text = "Loading image...", Font = F.Gotham, TextSize = 12, TextColor3 = T("Sub"), Size = UDim2.fromScale(1, 1), Parent = imgHolder })

		New("TextLabel", { BackgroundTransparency = 1, Text = tostring(s.title or "Untitled"), Font = F.GothamBold, TextSize = 14, TextColor3 = T("Text"), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(16, 144), Size = UDim2.new(1, -32, 0, 38), Parent = card })
		New("TextLabel", { BackgroundTransparency = 1, Text = describe(s), Font = F.Gotham, TextSize = 11, TextColor3 = T("Sub"), TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(16, 184), Size = UDim2.new(1, -32, 0, 16), Parent = card })

		local descBox = New("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(16, 206), Size = UDim2.new(1, -32, 0, 64), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 3, ScrollingDirection = Enum.ScrollingDirection.Y, Parent = card })
		local descLbl = New("TextLabel", { BackgroundTransparency = 1, Text = "Loading description...", Font = F.Gotham, TextSize = 12, TextColor3 = T("Text"), TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = descBox })

		local status = New("TextLabel", { BackgroundTransparency = 1, Text = "", Font = F.Gotham, TextSize = 12, TextColor3 = T("Sub"), TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(16, 284), Size = UDim2.new(1, -32, 0, 16), Parent = card })

		task.spawn(function()
			local asset = getImage(s)
			if not card.Parent then return end
			if asset then
				img.Image = asset
				img.Visible = true
				imgNote.Visible = false
			else
				imgNote.Text = "No image available"
			end
		end)
		task.spawn(function()
			local d = getDescription(s)
			if not card.Parent then return end
			descLbl.Text = d
		end)

		local function close()
			modalOpen = false
			overlay:Destroy()
		end
		local busy = false
		local function withCode(fn)
			if busy then return end
			busy = true
			status.Text = "Fetching script..."
			task.spawn(function()
				local code = getCode(s)
				busy = false
				if not card.Parent then return end
				if not code or code == "" then
					status.Text = "Couldn't fetch this script."
					return
				end
				status.Text = ""
				fn(code)
			end)
		end

		local copyBtn = Button(card, "Copy", 110, 32, false, { Position = UDim2.fromOffset(16, 326) })
		local sendBtn = Button(card, "Send to Editor", 130, 32, true, { Position = UDim2.fromOffset(134, 326) })
		local closeB = Button(card, "Close", 84, 32, false, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 326) })

		copyBtn.MouseButton1Click:Connect(function()
			withCode(function(code)
				if copy(code) then notify("Script copied to your clipboard.", "success") else notify("Your executor doesn't support clipboard access.", "error") end
			end)
		end)
		sendBtn.MouseButton1Click:Connect(function()
			withCode(function(code)
				close()
				Exec.AddScript(s.title or "Script", code)
				showPage("Executor")
				notify("Sent to the editor.", "success")
			end)
		end)
		closeB.MouseButton1Click:Connect(close)
		overlay.MouseButton1Click:Connect(close)
	end

	local function render(scripts)
		clearList()
		if #scripts == 0 then message("No scripts found.") return end
		local thumbs = {}
		for _, s in ipairs(scripts) do
			local c = Card(list, 62)
			local holder = New("Frame", { BorderSizePixel = 0, BackgroundColor3 = T("Surface2"), Position = UDim2.fromOffset(10, 9), Size = UDim2.fromOffset(44, 44), ClipsDescendants = true, Parent = c })
			corner(holder, 6)
			local thumb = New("ImageLabel", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ScaleType = Enum.ScaleType.Crop, Image = "", Visible = false, Parent = holder })
			thumbs[#thumbs + 1] = { s, thumb }
			Text(c, tostring(s.title or "Untitled"), 13, "Text", F.GothamMedium, { Position = UDim2.fromOffset(64, 12), Size = UDim2.new(1, -78, 0, 18), TextTruncate = Enum.TextTruncate.AtEnd })
			Text(c, describe(s), 11, "Sub", F.Gotham, { Position = UDim2.fromOffset(64, 33), Size = UDim2.new(1, -78, 0, 16), TextTruncate = Enum.TextTruncate.AtEnd })
			local hit = New("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = c })
			hit.MouseEnter:Connect(function() tween(c, { BackgroundColor3 = T("Surface2") }, 0.12) end)
			hit.MouseLeave:Connect(function() tween(c, { BackgroundColor3 = T("Surface") }, 0.12) end)
			hit.MouseButton1Click:Connect(function() openScript(s) end)
		end

		local tok = fetchToken
		task.spawn(function()
			for _, t in ipairs(thumbs) do
				if tok ~= fetchToken then return end
				local asset = getImage(t[1])
				if asset and t[2].Parent then
					t[2].Image = asset
					t[2].Visible = true
				end
			end
		end)
	end

	local function load(q, pg)
		fetchToken += 1
		local tok = fetchToken
		message("Loading scripts...")
		pageLbl.Text = "..."
		task.spawn(function()
			local url
			if q ~= "" then
				url = SCRIPTBLOX_API .. "search?q=" .. HttpService:UrlEncode(q) .. "&page=" .. pg .. "&max=20"
			else
				url = SCRIPTBLOX_API .. "fetch?page=" .. pg .. "&max=20"
			end
			local body = httpGet(url)
			if tok ~= fetchToken then return end
			local ok, res = pcall(function() return HttpService:JSONDecode(body) end)
			if not (ok and type(res) == "table" and type(res.result) == "table" and type(res.result.scripts) == "table") then
				updatePageLabel()
				message("Couldn't reach ScriptBlox. Try again in a moment.", "bad")
				return
			end
			query, page = q, pg
			totalPages = math.max(tonumber(res.result.totalPages) or 1, 1)
			updatePageLabel()
			render(res.result.scripts)
			list.CanvasPosition = Vector2.new(0, 0)
		end)
	end

	local function doSearch() load(trim(searchBox.Text), 1) end
	searchBtn.MouseButton1Click:Connect(doSearch)
	searchBox.FocusLost:Connect(function(enter) if enter then doSearch() end end)
	latestBtn.MouseButton1Click:Connect(function()
		searchBox.Text = ""
		load("", 1)
	end)
	prevBtn.MouseButton1Click:Connect(function() if page > 1 then load(query, page - 1) end end)
	nextBtn.MouseButton1Click:Connect(function() if page < totalPages then load(query, page + 1) end end)

	connect(P:GetPropertyChangedSignal("Visible"), function()
		if P.Visible and not loadedOnce then
			loadedOnce = true
			load("", 1)
		end
	end)
end

do
	local P = Pages.Misc
	local sound = Instance.new("Sound")
	sound.Name = "MonarchyAudio"
	sound.Volume = 0.5
	sound.Parent = SoundService
	Misc.sound = sound

	Section(P, "Background Music")
	local mc = Card(P)
	Pad(mc, 12, 12, 12, 12)
	New("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = mc })
	local row = Frame(mc, nil, { Size = UDim2.new(1, 0, 0, 30) })
	New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = row })
	local idBox = Input(row, "Roblox audio ID", 186, 30)
	local playBtn = Button(row, "Play", 64, 30, true)
	local pauseBtn = Button(row, "Pause", 64, 30)
	local resetBtn = Button(row, "Reset", 64, 30)
	local nowLbl = Text(mc, "Nothing playing", 12, "Sub", F.Gotham, { Size = UDim2.new(1, 0, 0, 16) })
	local barBg = Frame(mc, "Border", { Size = UDim2.new(1, 0, 0, 4) })
	corner(barBg, 2)
	local barFill = Frame(barBg, "Accent", { Size = UDim2.fromScale(0, 1) })
	corner(barFill, 2)

	local title = nil
	playBtn.MouseButton1Click:Connect(function()
		local id = idBox.Text:gsub("%D", "")
		if id ~= "" and sound.SoundId ~= "rbxassetid://" .. id then
			sound:Stop()
			sound.SoundId = "rbxassetid://" .. id
			sound.TimePosition = 0
			title = nil
			nowLbl.Text = "Loading..."
			task.spawn(function()
				local ok, info = pcall(function() return MarketplaceService:GetProductInfo(tonumber(id)) end)
				title = (ok and info and info.Name) or ("ID " .. id)
			end)
			sound:Play()
			local myId = sound.SoundId
			task.delay(4, function()
				if sound.SoundId == myId and sound.TimeLength == 0 then notify("Audio failed to load (invalid or private ID?).", "error") end
			end)
		elseif sound.SoundId == "" then
			notify("Enter an audio ID first.", "error")
		else
			if sound.IsPaused then sound:Resume() elseif not sound.IsPlaying then sound:Play() end
		end
	end)
	pauseBtn.MouseButton1Click:Connect(function() sound:Pause() end)
	resetBtn.MouseButton1Click:Connect(function()
		sound:Stop()
		sound.TimePosition = 0
	end)

	local function fmtTime(s)
		s = math.floor(s or 0)
		return string.format("%d:%02d", math.floor(s / 60), s % 60)
	end
	local acc = 0
	connect(RunService.Heartbeat, function(dt)
		acc += dt
		if acc < 0.25 then return end
		acc = 0
		if sound.SoundId == "" then return end
		local state = sound.IsPlaying and "Playing" or (sound.IsPaused and "Paused" or "Stopped")
		local len = sound.TimeLength
		nowLbl.Text = string.format("%s: %s  ·  %s / %s", state, title or "...", fmtTime(sound.TimePosition), fmtTime(len))
		barFill.Size = UDim2.fromScale(len > 0 and math.clamp(sound.TimePosition / len, 0, 1) or 0, 1)
	end)

	Toggle(P, "Loop", "Repeat the current track", false, function(v) sound.Looped = v end)
	Slider(P, "Volume", 0, 1, 0.5, function(v) return string.format("%d%%", math.floor(v * 100 + 0.5)) end, function(v) sound.Volume = v end)

	Section(P, "Scripts")
	local iy = RowCard(P, "Infinite Yield", "Universal admin command script")

	local iyBusy = false
	local launchIY = Button(iy, "Launch", 90, 28, true, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0) })
	launchIY.MouseButton1Click:Connect(function()
		if iyBusy then return end
		if env.IY_LOADED then notify("Infinite Yield is already running.", "error") return end
		if not loadstring then notify("loadstring isn't available in this environment.", "error") return end
		iyBusy = true
		launchIY.Text = "Loading..."
		task.spawn(function()
			local src
			for _, url in ipairs(INFINITE_YIELD_URLS) do
				local body = httpGet(url)
				if type(body) == "string" and #body > 5000 and not body:find("^%s*<") then
					src = body
					break
				end
			end
			if not src then
				iyBusy = false
				launchIY.Text = "Launch"
				notify("Couldn't download Infinite Yield.", "error")
				return
			end
			local fn, err = loadstring(src)
			if not fn then
				iyBusy = false
				launchIY.Text = "Launch"
				notify("Infinite Yield failed to compile: " .. string.sub(tostring(err), 1, 120), "error")
				return
			end
			task.wait(0.15)
			task.spawn(function()
				local ok, e = pcall(fn)
				iyBusy = false
				launchIY.Text = "Launch"
				if ok then notify("Infinite Yield launched.", "success") else notify("Infinite Yield error: " .. string.sub(tostring(e), 1, 120), "error") end
			end)
		end)
	end)

	Section(P, "Commands")
	local afkConn, voidConn
	Toggle(P, "Anti-AFK", "Prevents you from being kicked for idling", false, function(v)
		if afkConn then afkConn:Disconnect() afkConn = nil end
		if v then
			afkConn = LocalPlayer.Idled:Connect(function()
				local ok = pcall(function()
					local vu = game:GetService("VirtualUser")
					vu:CaptureController()
					vu:ClickButton2(Vector2.new())
				end)
				if not ok then pcall(function() LocalPlayer.Character:FindFirstChildOfClass("Humanoid"):Move(Vector3.new(0, 0, 0)) end) end
			end)
		end
	end)
	Misc.stopCommands = function()
		if afkConn then afkConn:Disconnect() afkConn = nil end
		if voidConn then voidConn:Disconnect() voidConn = nil end
	end

	Toggle(P, "Anti-Void", "Teleports you back if you fall into the void", false, function(v)
		if voidConn then voidConn:Disconnect() voidConn = nil end
		if v then
			local lastSafe, lastChar = nil, nil
			voidConn = RunService.Heartbeat:Connect(function()
				local char = LocalPlayer.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if not hrp or not hum then return end
				if char ~= lastChar then lastChar, lastSafe = char, nil end
				local limit = math.max(workspace.FallenPartsDestroyHeight, -10000) + 60
				if hum.FloorMaterial ~= Enum.Material.Air and hrp.Position.Y > limit + 25 then
					lastSafe = hrp.CFrame
				end
				if hrp.Position.Y < limit and lastSafe then
					hrp.AssemblyLinearVelocity = Vector3.zero
					hrp.CFrame = lastSafe + Vector3.new(0, 3, 0)
				end
			end)
		end
	end)

	local function action(title2, sub, label, fn)
		local c = RowCard(P, title2, sub)
		Button(c, label, 110, 28, false, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0) }).MouseButton1Click:Connect(fn)
	end
	action("Rejoin", "Rejoin the current server", "Rejoin", function()
		notify("Rejoining...")
		task.spawn(function()
			if #Players:GetPlayers() <= 1 then
				LocalPlayer:Kick("\nRejoining...")
				task.wait()
				TeleportService:Teleport(game.PlaceId, LocalPlayer)
			else
				TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
			end
		end)
	end)
	action("Server Hop", "Join a different public server", "Server Hop", function()
		notify("Searching for a server...")
		task.spawn(function()
			local body = httpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
			local ok, res = pcall(function() return HttpService:JSONDecode(body) end)
			if not (body and ok and res and res.data) then notify("Couldn't fetch the server list.", "error") return end
			local choices = {}
			for _, s in ipairs(res.data) do
				if s.id ~= game.JobId and s.playing and s.maxPlayers and s.playing < s.maxPlayers then choices[#choices + 1] = s.id end
			end
			if #choices == 0 then notify("No other servers found.", "error") return end
			TeleportService:TeleportToPlaceInstance(game.PlaceId, choices[math.random(#choices)], LocalPlayer)
		end)
	end)
	action("Reset Character", "Respawn your character", "Reset", function()
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then hum.Health = 0 else notify("No character found.", "error") end
	end)
end

local widgetBar, widgetLabels
do
	local P = Pages.Settings

	local function AddToggle(title, sub, key, effect)
		local tg = Toggle(P, title, sub, S[key], function(v)
			S[key] = v
			if effect then effect() end
		end)
		Setters[key] = function(v) tg.Set(v) end
		return tg
	end

	Section(P, "Appearance")
	local tc = Card(P)
	Pad(tc, 10, 10, 10, 10)
	New("UIGridLayout", { CellSize = UDim2.new(1 / 3, -6, 0, 30), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = tc })
	local chips = {}
	for _, name in ipairs(ThemeOrder) do
		local th = Themes[name]
		local b = New("TextButton", { AutoButtonColor = false, BorderSizePixel = 0, Text = name, Font = F.GothamMedium, TextSize = 12, BackgroundColor3 = Color3.fromHex(th.Bg), TextColor3 = Color3.fromHex(th.Text), Parent = tc })
		corner(b, 6)
		chips[name] = New("UIStroke", { Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = b })
		b.MouseButton1Click:Connect(function() Setters.Theme(name) end)
	end
	onTheme(function()
		for name, st in pairs(chips) do
			local sel = name == S.Theme
			st.Color = sel and T("Accent") or Color3.fromHex(Themes[name].Border)
			st.Thickness = sel and 2 or 1
		end
	end)
	Setters.Theme = function(name)
		if Themes[name] then applyTheme(name) end
	end

	local kr = RowCard(P, "Toggle UI Keybind")
	local kb = Button(kr, S.Keybind.Name, 100, 28, false, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0) })
	Setters.Keybind = function(code)
		if typeof(code) == "string" then
			local ok, kc = pcall(function() return Enum.KeyCode[code] end)
			if not ok or not kc then return end
			code = kc
		end
		if typeof(code) ~= "EnumItem" then return end
		S.Keybind = code
		kb.Text = code.Name
	end
	kb.MouseButton1Click:Connect(function()
		kb.Text = "Press a key..."
		Listen.key = function(code)
			Listen.key = nil
			if code == Enum.KeyCode.Escape then kb.Text = S.Keybind.Name else Setters.Keybind(code) end
		end
	end)

	AddToggle("Dim Background", nil, "Dim", function() Fx.Dim() end)
	AddToggle("Square UI", nil, "Square", function() setSquare(S.Square) end)
	AddToggle("Square Switches", "Square toggle switches instead of rounded ones", "SquareSwitches", function() setSquareSwitches(S.SquareSwitches) end)
	local opSlider = Slider(P, "UI Opacity", 0.3, 1, S.Opacity, function(v) return string.format("%d%%", math.floor(v * 100 + 0.5)) end, function(v)
		S.Opacity = v
		Fx.Opacity()
	end)
	Setters.Opacity = function(v) opSlider.Set(tonumber(v) or 1) end
	AddToggle("Reduce Motion Effects", nil, "ReduceMotion", function() Motion.Reduce = S.ReduceMotion end)
	AddToggle("Completely Disable Motion Effects", nil, "NoMotion", function() Motion.Off = S.NoMotion end)

	Section(P, "Widgets")
	AddToggle("Enable Widgets", nil, "Widgets", function() Fx.Widgets() end)
	AddToggle("FPS Counter", nil, "FPS", function() Fx.Widgets() end)
	AddToggle("Ping Shower", nil, "Ping", function() Fx.Widgets() end)
	AddToggle("Memory Usage", nil, "Mem", function() Fx.Widgets() end)
	AddToggle("Local Time", nil, "Time", function() Fx.Widgets() end)

	Section(P, "Background Image")
	local bc = Card(P, 54)
	local bgBox = Input(bc, "Image asset ID", 250, 30)
	bgBox.Position = UDim2.fromOffset(12, 12)
	local applyBtn = Button(bc, "Apply", 70, 30, true, { Position = UDim2.fromOffset(270, 12) })
	local clearBg = Button(bc, "Remove", 70, 30, false, { Position = UDim2.fromOffset(346, 12) })
	Setters.BgId = function(id)
		S.BgId = tostring(id or ""):gsub("%D", "")
		bgBox.Text = S.BgId
		Fx.Bg()
	end
	applyBtn.MouseButton1Click:Connect(function()
		if bgBox.Text:gsub("%D", "") == "" then notify("Enter an image ID first.", "error") return end
		Setters.BgId(bgBox.Text)
	end)
	clearBg.MouseButton1Click:Connect(function() Setters.BgId("") end)
	local bgSlider = Slider(P, "Background Image Visibility", 0, 1, S.BgVis, function(v) return string.format("%d%%", math.floor(v * 100 + 0.5)) end, function(v)
		S.BgVis = v
		Fx.Bg()
	end)
	Setters.BgVis = function(v) bgSlider.Set(tonumber(v) or 0.5) end
	local bgSizeSlider = Slider(P, "Background Image Size", 0.25, 2, S.BgSize, function(v) return string.format("%d%%", math.floor(v * 100 + 0.5)) end, function(v)
		S.BgSize = v
		Fx.Bg()
	end)
	Setters.BgSize = function(v) bgSizeSlider.Set(tonumber(v) or 1) end

	Section(P, "Config Editor")
	local cc = Card(P)
	Pad(cc, 12, 12, 12, 12)
	New("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = cc })
	local crow = Frame(cc, nil, { Size = UDim2.new(1, 0, 0, 30) })
	New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = crow })
	local nameBox = Input(crow, "Config name", 170, 30)
	local saveBtn = Button(crow, "Save", 70, 30, true)
	local loadBtn = Button(crow, "Load", 70, 30)
	local delBtn = Button(crow, "Delete", 70, 30)
	local listFrame = Frame(cc, nil, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	New("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = listFrame })

	local function ensureFolders()
		if not FS.ok then return end
		pcall(function()
			if not isfolder("Monarchy") then makefolder("Monarchy") end
			if not isfolder("Monarchy/configs") then makefolder("Monarchy/configs") end
		end)
	end
	local function cfgPath(n) return "Monarchy/configs/" .. n .. ".json" end
	local function listConfigs()
		local names = {}
		if FS.ok then
			ensureFolders()
			local ok, files = pcall(listfiles, "Monarchy/configs")
			if ok and type(files) == "table" then
				for _, f in ipairs(files) do
					local n = tostring(f):match("([^/\\]+)%.json$")
					if n then names[#names + 1] = n end
				end
			end
		else
			for n in pairs(memCfg) do names[#names + 1] = n end
		end
		table.sort(names)
		return names
	end
	local function refreshList()
		for _, c in ipairs(listFrame:GetChildren()) do
			if c:IsA("TextButton") then c:Destroy() end
		end
		local names = listConfigs()
		if #names == 0 then
			local b = New("TextButton", { AutoButtonColor = false, BackgroundTransparency = 1, Text = "No saved configs yet.", Font = F.Gotham, TextSize = 12, TextColor3 = T("Sub"), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 20), Parent = listFrame })
			return
		end
		for _, n in ipairs(names) do
			local b = New("TextButton", { AutoButtonColor = false, BorderSizePixel = 0, Text = n, Font = F.GothamMedium, TextSize = 12, TextColor3 = T("Text"), BackgroundColor3 = T("Surface2"), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 26), Parent = listFrame })
			Pad(b, 10, 0, 10, 0)
			corner(b, 5)
			b.MouseButton1Click:Connect(function() nameBox.Text = n end)
		end
	end
	onTheme(refreshList)

	local lastName = ""
	local function collect()
		local list, active = Exec.Get()
		return {
			LastConfig = lastName,
			Theme = S.Theme, Keybind = S.Keybind.Name, Widgets = S.Widgets, FPS = S.FPS, Ping = S.Ping, Mem = S.Mem, Time = S.Time,
			Dim = S.Dim, Square = S.Square, ReduceMotion = S.ReduceMotion, NoMotion = S.NoMotion,
			BgId = S.BgId, BgVis = S.BgVis, BgSize = S.BgSize, Opacity = S.Opacity, SquareSwitches = S.SquareSwitches, Scripts = list, Active = active,
		}
	end
	local function applyConfig(c)
		if type(c) ~= "table" then return end
		if c.Theme then Setters.Theme(c.Theme) end
		if c.Keybind then Setters.Keybind(c.Keybind) end
		for _, k in ipairs({ "Widgets", "FPS", "Ping", "Mem", "Time", "Dim", "Square", "SquareSwitches", "ReduceMotion", "NoMotion" }) do
			if c[k] ~= nil then Setters[k](c[k]) end
		end
		if c.BgVis ~= nil then Setters.BgVis(c.BgVis) end
		if c.BgId ~= nil then Setters.BgId(c.BgId) end
		if c.BgSize ~= nil then Setters.BgSize(c.BgSize) end
		if c.Opacity ~= nil then Setters.Opacity(c.Opacity) end
		if c.Scripts then Exec.Set(c.Scripts, c.Active) end
	end
	local function cleanName(s) return trim((s:gsub("[^%w _%-]", ""))) end

	saveBtn.MouseButton1Click:Connect(function()
		local n = cleanName(nameBox.Text)
		if n == "" then notify("Enter a config name.", "error") return end
		local ok, json = pcall(function() return HttpService:JSONEncode(collect()) end)
		if not ok then notify("Couldn't encode the config.", "error") return end
		if FS.ok then
			ensureFolders()
			local ok2, err = pcall(writefile, cfgPath(n), json)
			if not ok2 then notify("Save failed: " .. string.sub(tostring(err), 1, 120), "error") return end
		else
			memCfg[n] = json
		end
		lastName = n
		notify("Saved config '" .. n .. "'.", "success")
		refreshList()
	end)
	loadBtn.MouseButton1Click:Connect(function()
		local n = cleanName(nameBox.Text)
		if n == "" then notify("Enter a config name.", "error") return end
		local json
		if FS.ok then
			local ok, res = pcall(function()
				if isfile(cfgPath(n)) then return readfile(cfgPath(n)) end
			end)
			json = ok and res or nil
		else
			json = memCfg[n]
		end
		if not json then notify("Config '" .. n .. "' not found.", "error") return end
		local ok, data = pcall(function() return HttpService:JSONDecode(json) end)
		if not ok then notify("That config is corrupted.", "error") return end
		applyConfig(data)
		lastName = n
		notify("Loaded config '" .. n .. "'.", "success")
	end)
	delBtn.MouseButton1Click:Connect(function()
		local n = cleanName(nameBox.Text)
		if n == "" then notify("Enter a config name.", "error") return end
		local removed = false
		if FS.ok then
			if delfile then
				removed = pcall(function()
					if isfile(cfgPath(n)) then delfile(cfgPath(n)) else error("missing") end
				end)
			end
		else
			removed = memCfg[n] ~= nil
			memCfg[n] = nil
		end
		if removed then notify("Deleted config '" .. n .. "'.", "success") else notify("Couldn't delete '" .. n .. "'.", "error") end
		refreshList()
	end)

	local LAST_PATH = "Monarchy/last.json"
	local lastSaved = nil
	local function writeLast()
		local ok, json = pcall(function() return HttpService:JSONEncode(collect()) end)
		if not ok or json == lastSaved then return end
		lastSaved = json
		if FS.ok then
			ensureFolders()
			pcall(writefile, LAST_PATH, json)
		else
			env.MonarchyLast = json
		end
	end
	Misc.saveLast = writeLast
	Misc.loadLast = function()
		local json
		if FS.ok then
			local ok, res = pcall(function()
				if isfile(LAST_PATH) then return readfile(LAST_PATH) end
			end)
			json = ok and res or nil
		else
			json = env.MonarchyLast
		end
		if type(json) ~= "string" or json == "" then return false end
		local ok, data = pcall(function() return HttpService:JSONDecode(json) end)
		if not ok or type(data) ~= "table" then return false end
		pcall(applyConfig, data)
		if type(data.LastConfig) == "string" then
			lastName = data.LastConfig
			if lastName ~= "" then nameBox.Text = lastName end
		end
		lastSaved = nil
		return true
	end
	Misc.startAutosave = function()
		task.spawn(function()
			while gui.Parent do
				task.wait(2)
				if not gui.Parent then break end
				pcall(writeLast)
			end
		end)
	end

	Section(P, "Danger Zone")
	local tz = RowCard(P, "Terminate Monarchy")
	Button(tz, "Terminate", 100, 28, "danger", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0) }).MouseButton1Click:Connect(function()
		if Misc.unload then Misc.unload() end
	end)
end

do
	local P = Pages.Credits
	Text(P, "Credits", 20, "Text", F.GothamBold, { Size = UDim2.new(1, 0, 0, 28) })
	local function credit(role, name, detail)
		local c = Card(P, 70)
		Text(c, string.upper(role), 11, "Sub", F.GothamBold, { Position = UDim2.fromOffset(16, 10), Size = UDim2.new(1, -32, 0, 14) })
		Text(c, name, 16, "Text", F.GothamBold, { Position = UDim2.fromOffset(16, 26), Size = UDim2.new(1, -32, 0, 20) })
		Text(c, detail, 12, "Sub", F.Gotham, { Position = UDim2.fromOffset(16, 47), Size = UDim2.new(1, -32, 0, 16) })
	end
	credit("Creator", "malachiqx", "Discord: malachiqx   ·   Roblox: malachiqx")
	credit("Helper", "qfk7", "Discord: qfk7   ·   Roblox: uhhtheoo")
	credit("Code", "Open Source", "https://github.com/qxs-scripts/monarchy/blob/main/main")

	local dc = RowCard(P, "Community", "Join the Monarchy Discord server")
	Button(dc, "Join Discord", 120, 28, true, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0) }).MouseButton1Click:Connect(function()
		if copy(DISCORD_URL) then
			notify("Discord invite copied to your clipboard: " .. DISCORD_URL, "success")
		else
			notify("Join here: " .. DISCORD_URL)
		end
	end)
end

do
	widgetBar = New("Frame", { Name = "Widgets", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.fromOffset(0, 28), AutomaticSize = Enum.AutomaticSize.X, BorderSizePixel = 0, Active = true, ZIndex = 3, Parent = gui })
	bind(widgetBar, "BackgroundColor3", "Topbar")
	widgetBar.BackgroundTransparency = 0.08
	corner(widgetBar, 8)
	stroke(widgetBar, "Border")
	Pad(widgetBar, 4, 0, 4, 0)
	New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = widgetBar })
	draggable(widgetBar, widgetBar)

	local function widget()
		local l = New("TextLabel", { BackgroundTransparency = 1, Text = "", Font = F.GothamMedium, TextSize = 12, Size = UDim2.fromOffset(0, 28), AutomaticSize = Enum.AutomaticSize.X, Parent = widgetBar })
		bind(l, "TextColor3", "Text")
		Pad(l, 9, 0, 9, 0)
		return l
	end
	widgetLabels = { FPS = widget(), Ping = widget(), Mem = widget(), Time = widget() }

	Fx.Widgets = function()
		local any = false
		for key, lbl in pairs(widgetLabels) do
			lbl.Visible = S[key]
			if S[key] then any = true end
		end
		widgetBar.Visible = S.Widgets and any
	end

	local fps, frames, acc = 60, 0, 0
	local function pingMs()
		local ok, v = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
		return ok and math.floor(v + 0.5) or 0
	end
	local function memMb()
		local ok, v = pcall(function() return Stats:GetTotalMemoryUsageMb() end)
		return ok and type(v) == "number" and math.floor(v + 0.5) or 0
	end
	local function clock()
		return (os.date("%I:%M:%S %p"):gsub("^0", ""))
	end
	connect(RunService.RenderStepped, function(dt)
		frames += 1
		acc += dt
		if acc >= 0.5 then
			fps = math.floor(frames / acc + 0.5)
			frames, acc = 0, 0
			widgetLabels.FPS.Text = "FPS  " .. fps
			widgetLabels.Ping.Text = "Ping  " .. pingMs() .. " ms"
			widgetLabels.Mem.Text = "Mem  " .. memMb() .. " MB"
			widgetLabels.Time.Text = clock()
		end
	end)
	widgetLabels.FPS.Text = "FPS  --"
	widgetLabels.Ping.Text = "Ping  -- ms"
	widgetLabels.Mem.Text = "Mem  " .. memMb() .. " MB"
	widgetLabels.Time.Text = clock()
	Fx.Widgets()
end

connect(UserInputService.InputBegan, function(input, gp)
	if Listen.key then
		if input.UserInputType == Enum.UserInputType.Keyboard then Listen.key(input.KeyCode) end
		return
	end
	if gp then return end
	if input.KeyCode == S.Keybind then setOpen(not open) end
end)

function Misc.unload()
	if Misc.saveLast then pcall(Misc.saveLast) end
	if Misc.stopCommands then pcall(Misc.stopCommands) end
	for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
	pcall(function()
		Misc.sound:Stop()
		Misc.sound:Destroy()
	end)
	pcall(function() gui:Destroy() end)
	env.MonarchyUnload = nil
end
env.MonarchyUnload = Misc.unload

local function refreshScale()
	local cam = workspace.CurrentCamera
	if not cam then return end
	local vp = cam.ViewportSize
	baseScale = math.clamp(math.min((vp.X - 24) / 760, (vp.Y - 24) / 480), 0.4, 1)
	if open then uiscale.Scale = activeScale() end
	keepOnScreen(main)
end
refreshScale()
do
	local cam = workspace.CurrentCamera
	if cam then connect(cam:GetPropertyChangedSignal("ViewportSize"), refreshScale) end
end

gui.Parent = getGuiParent()
showPage("Home")
local restored = Misc.loadLast and Misc.loadLast()
if Misc.startAutosave then Misc.startAutosave() end
Fx.Bg()
Fx.Opacity()
setOpen(true)
notify("Monarchy " .. VERSION .. " loaded. Press " .. S.Keybind.Name .. " to toggle.", "success")
if restored then notify("Restored your most recent settings.", "success") end

task.delay(0.4, function() Misc.checkUpdates(true) end)
