	local plusBtn = IconButton(left, "plus", 26, 14, "Text", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 1) })

	Text(side, "Scripts", 13, "Text", F.GothamBold, { Position = UDim2.fromOffset(10, 8), Size = UDim2.new(1, -44, 0, 20) })
	local sidePlus = IconButton(side, "plus", 22, 13, "Text", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -6, 0, 7) })
