	if fpad then fpad.PaddingLeft = UDim.new(0, 24) end
	local searchIc = Icons.search(filterBox, 12, "Sub")
	searchIc.Root.Position = UDim2.fromOffset(-17, 7)
	local listScroll = New("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(8, 68), Size = UDim2.new(1, -16, 1, -(68 + 66)), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 3, ScrollingDirection = Enum.ScrollingDirection.Y, Parent = side })
	bind(listScroll, "ScrollBarImageColor3", "Border")
	New("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = listScroll })
	local newBtn = Button(side, "New script", 100, 26, false, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 8, 1, -34), Size = UDim2.new(1, -16, 0, 26), TextSize = 12 })
	Text(side, "Double-click a tab for options", 10, "Sub", F.Gotham, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 10, 1, -6), Size = UDim2.new(1, -20, 0, 24), TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Bottom })

	local function showScriptMenu(i)
		local items = {
			{ "Rename", function() renameScript(i) end },
			{ "Duplicate", function() duplicateScript(i) end },
			{ "Copy Script", function() copyScript(i) end },
			{ "New Tab", newScript },
		}
		if i == activeScript then items[#items + 1] = { "Clear Editor", clearEditor } end
		items[#items + 1] = { "Delete", function() deleteScript(i) end, true }
		showMenu(items)
	end
	local lastClickIdx, lastClickT = nil, 0
	local function clickScript(i)
		if modalOpen then return end
		local now = os.clock()
		if lastClickIdx == i and now - lastClickT < 0.4 then
			lastClickIdx = nil
			showScriptMenu(i)
		else
			lastClickIdx, lastClickT = i, now
			switchScript(i)
		end
	end

	local listRows = {}
	local function renderList()
		for _, r in ipairs(listRows) do r:Destroy() end
		listRows = {}
		local q = string.lower(trim(filterBox.Text))
		for i, s in ipairs(scripts) do
			if q == "" or string.find(string.lower(s.name), q, 1, true) then
				local active = i == activeScript
				local b = New("TextButton", {
					AutoButtonColor = false, BorderSizePixel = 0, Text = s.name, Font = F.GothamMedium, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, 0, 0, 26), LayoutOrder = i, Parent = listScroll,
					BackgroundColor3 = T("Surface2"), BackgroundTransparency = active and 0 or 1, TextColor3 = active and T("Text") or T("Sub"),
				})
				Pad(b, 26, 0, 6, 0)
				corner(b, 6)
				local ic = Icons.bolt(b, 12, active and "Text" or "Sub")
				ic.Root.Position = UDim2.fromOffset(-18, 7)
				b.MouseEnter:Connect(function() if i ~= activeScript then b.BackgroundTransparency = 0.6 end end)
				b.MouseLeave:Connect(function() if i ~= activeScript then b.BackgroundTransparency = 1 end end)
				b.MouseButton1Click:Connect(function() clickScript(i) end)
				listRows[#listRows + 1] = b
			end
		end
	end
	connect(filterBox:GetPropertyChangedSignal("Text"), renderList)

	function renderTabs()
		for _, b in ipairs(tabButtons) do b:Destroy() end
		tabButtons = {}
		for i, s in ipairs(scripts) do
			local active = i == activeScript
			local b = New("TextButton", {
				AutoButtonColor = false, BorderSizePixel = 0, Text = s.name, Font = F.GothamMedium, TextSize = 12,
				AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 26), LayoutOrder = i, Parent = tabsBar,
				BackgroundColor3 = T("Surface2"), BackgroundTransparency = active and 0 or 1,
				TextColor3 = active and T("Text") or T("Sub"),
			})
			Pad(b, 28, 0, 12, 0)
			corner(b, 7)
			New("UIStroke", { Color = T("Border"), Thickness = 1, Transparency = active and 0 or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = b })
			local ic = Icons.bolt(b, 12, active and "Text" or "Sub")
			ic.Root.Position = UDim2.fromOffset(-19, 7)
			b.MouseEnter:Connect(function() if i ~= activeScript then b.BackgroundTransparency = 0.6 end end)
			b.MouseLeave:Connect(function() if i ~= activeScript then b.BackgroundTransparency = 1 end end)
			b.MouseButton1Click:Connect(function() clickScript(i) end)
			tabButtons[i] = b
		end
		titleLbl.Text = scripts[activeScript] and scripts[activeScript].name or ""
		renderList()

		task.defer(function()
			local b = tabButtons[activeScript]
			if not b or not b.Parent then return end
			local l = b.AbsolutePosition.X - tabsBar.AbsolutePosition.X + tabsBar.CanvasPosition.X
			local r = l + b.AbsoluteSize.X
			local view = tabsBar.AbsoluteSize.X
			local cx = tabsBar.CanvasPosition.X
			if l < cx then cx = l elseif r > cx + view then cx = r - view end
			tabsBar.CanvasPosition = Vector2.new(math.max(cx, 0), 0)
		end)
	end
	onTheme(renderTabs)

