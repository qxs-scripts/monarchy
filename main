newPage("Script Hub", false)
newPage("Misc", true)
newPage("Settings", true)
newPage("Credits", true)

local tabBtns, currentPage = {}, nil
local function refreshTabs()
	for name, t in pairs(tabBtns) do
		local active = name == currentPage
		t[1].BackgroundColor3 = T("Surface2")
		t[1].BackgroundTransparency = active and 0 or 1
		t[2].TextColor3 = active and T("Text") or T("Sub")
		t[3].BackgroundColor3 = T("Accent")
		t[3].Visible = active
	end
end
local function showPage(name)
	if currentPage == name then return end
	currentPage = name
	closeMenu()
	for n, p in pairs(Pages) do p.Visible = (n == name) end
	refreshTabs()
	local p = Pages[name]
	p.Position = UDim2.fromOffset(0, 10)
	tween(p, { Position = UDim2.new() }, 0.2)
end
for _, name in ipairs(PageOrder) do
	local b = New("TextButton", { AutoButtonColor = false, BorderSizePixel = 0, Text = "", Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, Parent = tabList })
	corner(b, 6)
	local lbl = New("TextLabel", { BackgroundTransparency = 1, Text = name, Font = F.GothamMedium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -14, 1, 0), Parent = b })
	local bar = New("Frame", { BorderSizePixel = 0, Size = UDim2.fromOffset(3, 16), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Visible = false, Parent = b })
	corner(bar, 2)
	tabBtns[name] = { b, lbl, bar }
	b.MouseEnter:Connect(function() if currentPage ~= name then tween(b, { BackgroundTransparency = 0.7 }, 0.12) end end)
	b.MouseLeave:Connect(function() if currentPage ~= name then tween(b, { BackgroundTransparency = 1 }, 0.12) end end)
	b.MouseButton1Click:Connect(function() showPage(name) end)
end
onTheme(refreshTabs)

local open = false
local openToken = 0
local baseScale = 1
local function activeScale() return Win.Full and 1 or baseScale end
local function setOpen(v)
	open = v
	openToken += 1
	local tok = openToken
	if v then
		if Win.Full then
			fsFrame.Visible = true
		else
			main.Visible = true
			uiscale.Scale = activeScale() * 0.94
			tween(uiscale, { Scale = activeScale() }, 0.2, Enum.EasingStyle.Back)
		end
		tween(dim, { BackgroundTransparency = S.Dim and 0.55 or 1 }, 0.2)
	else
		closeMenu()
		if not Win.Full then tween(uiscale, { Scale = activeScale() * 0.94 }, 0.15) end
		tween(dim, { BackgroundTransparency = 1 }, 0.15)
		task.delay(Win.Full and 0.02 or 0.16, function()
			if openToken == tok then
				main.Visible = false
				fsFrame.Visible = false
			end
		end)
	end
end
closeBtn.MouseButton1Click:Connect(function() setOpen(false) end)

local WINDOW_SIZE = UDim2.fromOffset(760, 480)
local fsBtn = New("TextButton", { AutoButtonColor = false, BorderSizePixel = 0, BackgroundTransparency = 1, Text = "", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -46, 0.5, 0), Size = UDim2.fromOffset(30, 30), Parent = topbar })
bind(fsBtn, "BackgroundColor3", "Surface2")
corner(fsBtn, 6)
local fsOuter = New("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(14, 14), Parent = fsBtn })
stroke(fsOuter, "Sub", 1.5)
local fsInner = New("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(6, 6), Visible = false, Parent = fsBtn })
stroke(fsInner, "Sub", 1.5)
fsBtn.MouseEnter:Connect(function() fsBtn.BackgroundTransparency = 0 end)
fsBtn.MouseLeave:Connect(function() fsBtn.BackgroundTransparency = 1 end)

local function setFullscreen(v)
	if Win.Full == v then return end
	Win.Full = v
	fsInner.Visible = v
	fsOuter.Size = UDim2.fromOffset(v and 16 or 14, v and 16 or 14)
	local target = v and fsFrame or main
	topbar.Parent = target
	sidebar.Parent = target
	content.Parent = target
	if v then
		Win.PrevPos = main.Position
		uiscale.Scale = 1
		main.Visible = false
		fsFrame.Visible = open
	else
		main.Position = Win.PrevPos or UDim2.fromScale(0.5, 0.5)
		uiscale.Scale = baseScale
		fsFrame.Visible = false
		main.Visible = open
		keepOnScreen(main)
	end

	task.delay(0.25, function()
		if Exec.Refresh then pcall(Exec.Refresh) end
	end)
end
fsBtn.MouseButton1Click:Connect(function() setFullscreen(not Win.Full) end)
Misc.setFullscreen = setFullscreen

Fx.Dim = function()
	if open then tween(dim, { BackgroundTransparency = S.Dim and 0.55 or 1 }, 0.2) end
end
Fx.Bg = function()
	local id = tostring(S.BgId or ""):gsub("%D", "")
	if id == "" then
		bgImage.Image = ""
		bgImage.Visible = false
	else
		bgImage.Image = "rbxassetid://" .. id
		bgImage.ImageTransparency = 1 - S.BgVis
		bgImage.AnchorPoint = Vector2.new(0.5, 0.5)
		bgImage.Position = UDim2.fromScale(0.5, 0.5)
		bgImage.Size = UDim2.fromScale(S.BgSize, S.BgSize)
		bgImage.Visible = true
	end
end
Fx.Widgets = function() end
Fx.Opacity = function()
	main.GroupTransparency = 1 - math.clamp(S.Opacity, 0.3, 1)
end

do
	local P = Pages.Home
	local REPO_RAW = "https://raw.githubusercontent.com/qxs-scripts/monarchy/"
	local COMMITS_URL = "https://api.github.com/repos/qxs-scripts/monarchy/commits?path=LATEST-VERSION&per_page=10"
	local WHATS_NEW_URL = "https://raw.githubusercontent.com/qxs-scripts/monarchy/refs/heads/main/What's%20New%3F"

	Text(P, "Welcome, " .. LocalPlayer.DisplayName, 20, "Text", F.GothamBold, { Size = UDim2.new(1, 0, 0, 28) })
	Text(P, "Monarchy is loaded and ready.", 13, "Sub", F.Gotham)

	local vc = Card(P, 92)
	Text(vc, "CURRENT VERSION", 11, "Sub", F.GothamBold, { Position = UDim2.fromOffset(16, 14), Size = UDim2.new(0.5, -16, 0, 14) })
	Text(vc, VERSION, 22, "Text", F.GothamBold, { Position = UDim2.fromOffset(16, 38), Size = UDim2.new(0.5, -16, 0, 30) })
	Text(vc, "LATEST VERSION", 11, "Sub", F.GothamBold, { Position = UDim2.new(0.5, 8, 0, 14), Size = UDim2.new(0.5, -16, 0, 14) })
	local latestLbl = Text(vc, "...", 22, "Text", F.GothamBold, { Position = UDim2.new(0.5, 8, 0, 38), Size = UDim2.new(0.5, -16, 0, 30) })
	local reloadBtn, reloadIc = IconButton(vc, "reload", 30, 18, "Text", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8) })

	local sc = Card(P, 64)
	local statusLbl = Text(sc, "Checking for updates...", 15, "Sub", F.GothamBold, { Position = UDim2.fromOffset(16, 0), Size = UDim2.new(1, -32, 1, 0), TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Center })
	local statusState = "pending"
	local function refreshStatus()
		statusLbl.TextColor3 = statusState == "ok" and T("Good") or (statusState == "bad" and T("Bad") or T("Sub"))
	end
	onTheme(refreshStatus)
	local function setStatus(state, msg)
		statusState = state
		statusLbl.Text = msg
		refreshStatus()
	end

	local wn = Card(P)
	wn.Visible = false
	Pad(wn, 16, 14, 16, 14)
	New("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = wn })
	Text(wn, "WHAT'S NEW?", 11, "Sub", F.GothamBold, { Size = UDim2.new(1, 0, 0, 14) })
	local wnBody = Text(wn, "", 13, "Text", F.Gotham, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top })

	local rc = Card(P)
	Pad(rc, 16, 14, 16, 14)
	New("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = rc })
	Text(rc, "MOST RECENT VERSIONS", 11, "Sub", F.GothamBold, { Size = UDim2.new(1, 0, 0, 14) })
	local recentRows = {}

	local function fmtDate(iso)
		local ok, dt = pcall(DateTime.fromIsoDate, iso)
		if not ok or not dt then return tostring(iso or "unknown") end
		local ok2, text = pcall(function() return dt:FormatLocalTime("ll", "en-us") end)
		if not ok2 or type(text) ~= "string" then text = dt:ToIsoDate():sub(1, 10) end
		local diff = math.max(0, os.time() - dt.UnixTimestamp)
		local rel
		if diff < 60 then rel = "just now"
		elseif diff < 3600 then rel = math.floor(diff / 60) .. "m ago"
		elseif diff < 86400 then rel = math.floor(diff / 3600) .. "h ago"
		else rel = math.floor(diff / 86400) .. "d ago" end
		return text .. "  ·  " .. rel
	end

	local function renderRecent(list, note)
		for _, r in ipairs(recentRows) do r:Destroy() end
		recentRows = {}
		if note then
			recentRows[1] = Text(rc, note, 12, "Sub", F.Gotham, { Size = UDim2.new(1, 0, 0, 20) })
			return
		end
		for i, e in ipairs(list) do
			local row = Frame(rc, nil, { Size = UDim2.new(1, 0, 0, 22) })
			Text(row, e.ver .. (e.ver == VERSION and "  (current)" or ""), 13, i == 1 and "Text" or "Sub", F.GothamMedium, { Size = UDim2.new(0.5, 0, 1, 0) })
			Text(row, fmtDate(e.iso), 12, "Sub", F.Gotham, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0.5, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Right })
			recentRows[#recentRows + 1] = row
		end
	end
	renderRecent(nil, "Loading...")

	local recentToken = 0
	local function loadRecent()
		recentToken += 1
		local tok = recentToken
		renderRecent(nil, "Loading...")
		task.spawn(function()
			local body = httpGet(COMMITS_URL)
			local ok, commits = pcall(function() return HttpService:JSONDecode(body) end)
			if tok ~= recentToken then return end
			if not (body and ok and type(commits) == "table" and #commits > 0) then
				renderRecent(nil, "Couldn't load version history.")
				return
			end

			local out, byVer = {}, {}
			for _, c in ipairs(commits) do
				if tok ~= recentToken then return end
				local ver = ""
				local iso = type(c.commit) == "table" and type(c.commit.committer) == "table" and c.commit.committer.date or nil
				if c.sha and iso then
					local raw = httpGet(REPO_RAW .. c.sha .. "/LATEST-VERSION")
					ver = raw and trim(raw:match("^[^\r\n]*") or "") or ""
					if ver ~= "" and #ver <= 24 and not ver:find("^<") and not ver:find("%s") then
						if byVer[ver] then
							byVer[ver].iso = iso
						elseif #out < 3 then
							local e = { ver = ver, iso = iso }
							byVer[ver] = e
							out[#out + 1] = e
						end
					else
						ver = ""
					end
				end
				if #out >= 3 and ver ~= "" and ver ~= out[3].ver then break end
			end
			if tok ~= recentToken then return end
			if #out == 0 then renderRecent(nil, "Couldn't load version history.") else renderRecent(out) end
		end)
	end

	local wnToken = 0
	local function loadWhatsNew()
		wnToken += 1
		local tok = wnToken
		task.spawn(function()
			local body = httpGet(WHATS_NEW_URL .. "?t=" .. os.time())
			if tok ~= wnToken then return end
			if type(body) ~= "string" or body:find("^%s*404") or body:find("^%s*<") then
				wn.Visible = false
				return
			end
			body = trim(body:gsub("\r", ""))
			if body == "" then
				wn.Visible = false
				return
			end
			if #body > 3000 then body = body:sub(1, 3000) .. "..." end
			wnBody.Text = body
			wn.Visible = true
		end)
	end

	local checking = false
	local function checkUpdates(auto)
		if checking then return end
		checking = true
		wnToken += 1
		wn.Visible = false
		setStatus("pending", "Checking for updates...")
		latestLbl.Text = "..."
		loadRecent()
		task.spawn(function()
			local body
			for attempt = 1, 3 do

				body = httpGet(VERSION_URL .. "?t=" .. os.time() .. attempt)
				if body and not body:find("^%s*404") and not body:find("^%s*<") then break end
				body = nil
				task.wait(1.5)
			end
			checking = false
			if not body then
				latestLbl.Text = "Unknown"
				setStatus("bad", "Couldn't reach the update server.")
				return
			end
			local latest = trim(body:match("^[^\r\n]*") or "")
			latestLbl.Text = latest ~= "" and latest or "Unknown"
			if latest == VERSION then
				setStatus("ok", "✓  Up to Date!")
				loadWhatsNew()
			else
				setStatus("bad", "Get latest version here: " .. DISCORD_URL)
				if auto == true then
					notify("Update available: " .. latest .. ". See the Home tab.", "error")
				elseif copy(DISCORD_URL) then
					notify("Discord link copied to your clipboard.", "success")
				end
			end
		end)
	end
	reloadBtn.MouseButton1Click:Connect(function()

		reloadIc.Root.Rotation = 0
		tween(reloadIc.Root, { Rotation = 360 }, 0.5, Enum.EasingStyle.Quad)
		task.delay(0.55, function() reloadIc.Root.Rotation = 0 end)
		checkUpdates()
	end)
	Misc.checkUpdates = checkUpdates
end

do
	local exec = Pages.Executor
	local scripts = { { name = "Script 1", code = 'print("Hello from Monarchy!")' } }
	local activeScript = 1

	local FONT, SIZE = F.Code, 14
	local PADX, PADY = 8, 6
	local big = Vector2.new(100000, 100000)
	local charW = TextService:GetTextSize(string.rep("A", 40), SIZE, FONT, big).X / 40
	local lineH = TextService:GetTextSize("A\nA\nA", SIZE, FONT, big).Y / 3

	local SIDE_W, SIDE_GAP = 120, 8
	local TOP_H, HEAD_H, STATUS_H = 28, 30, 18
	local EDITOR_Y = TOP_H + 6 + HEAD_H + 6
	local PAGE_H = 412
	local consoleOpen, consoleH = true, 120
	local CONSOLE_MIN, EDITOR_MIN = 56, 80

	local left = Frame(exec, nil, { Size = UDim2.new(1, -(SIDE_W + SIDE_GAP), 1, 0) })
	local side = Frame(exec, "Surface", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, SIDE_W, 1, 0) })
	corner(side, 8)
	stroke(side, "Border")

	local tabsHolder = Frame(left, nil, { Size = UDim2.new(1, -32, 0, TOP_H), ClipsDescendants = true })
	local tabsBar = New("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollBarThickness = 0, ScrollingDirection = Enum.ScrollingDirection.X, Parent = tabsHolder })
	New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = tabsBar })
	Pad(tabsBar, 1, 0, 1, 0)

	local editorHolder = Frame(left, "Editor", { Position = UDim2.fromOffset(0, EDITOR_Y), Size = UDim2.new(1, 0, 1, -(EDITOR_Y + STATUS_H + 6 + consoleH + 6)), ClipsDescendants = true })
	corner(editorHolder, 8)
	stroke(editorHolder, "Border")

	local gutterClip = Frame(editorHolder, nil, { Size = UDim2.new(0, 40, 1, 0), ClipsDescendants = true })
	local gutter = New("TextLabel", { BackgroundTransparency = 1, Font = FONT, TextSize = SIZE, Text = "1", TextXAlignment = Enum.TextXAlignment.Right, TextYAlignment = Enum.TextYAlignment.Top, Size = UDim2.new(1, -6, 0, 400), Parent = gutterClip })
	bind(gutter, "TextColor3", "Sub")
	Pad(gutter, 0, PADY, 0, 0)
	Frame(editorHolder, "Border", { Position = UDim2.fromOffset(40, 0), Size = UDim2.new(0, 1, 1, 0) })

	local scroller = New("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(41, 0), Size = UDim2.new(1, -41, 1, 0), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.None, ScrollBarThickness = 5, ScrollingDirection = Enum.ScrollingDirection.XY, Parent = editorHolder })
	bind(scroller, "ScrollBarImageColor3", "Border")

	local box = New("TextBox", {
		BackgroundTransparency = 1, BorderSizePixel = 0, ClearTextOnFocus = false, MultiLine = true, TextWrapped = false, Font = FONT, TextSize = SIZE,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Text = "", Size = UDim2.fromScale(1, 1), ZIndex = 1, Parent = scroller,
	})
	bind(box, "TextColor3", "Editor")
	Pad(box, PADX, PADY, PADX, PADY)
	local hl = New("TextLabel", {
		BackgroundTransparency = 1, BorderSizePixel = 0, RichText = true, TextWrapped = false, Font = FONT, TextSize = SIZE, Text = "",
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Size = UDim2.fromScale(1, 1), ZIndex = 2, Active = false, Parent = scroller,
	})
	bind(hl, "TextColor3", "Text")
	Pad(hl, PADX, PADY, PADX, PADY)
	local caret = New("Frame", { BorderSizePixel = 0, Size = UDim2.fromOffset(2, lineH), Visible = false, ZIndex = 3, Parent = scroller })
	bind(caret, "BackgroundColor3", "Text")

	local popup = New("Frame", { BorderSizePixel = 0, Size = UDim2.fromOffset(220, 0), AutomaticSize = Enum.AutomaticSize.Y, Visible = false, ZIndex = 10, Parent = editorHolder })
	bind(popup, "BackgroundColor3", "Surface")
	corner(popup, 6)
	stroke(popup, "Border")
	Pad(popup, 3, 3, 3, 3)
	New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Parent = popup })

	local expected, prevText = nil, ""
	local suggestions, suggestPrefixLen = {}, 0
	local lastLines = 0
	local caretT = 0

	local function layout()
		local b = box.TextBounds
		local w = math.max(scroller.AbsoluteSize.X, b.X + PADX * 2 + 24)
		local h = math.max(scroller.AbsoluteSize.Y, b.Y + PADY * 2 + 24)
		box.Size = UDim2.fromOffset(w, h)
		hl.Size = box.Size
		scroller.CanvasSize = UDim2.fromOffset(w, h)
		gutter.Size = UDim2.new(1, -6, 0, h)
	end

	local function caretColLine()
		local pos = box.CursorPosition
		if pos < 1 then return nil end
		local before = box.Text:sub(1, pos - 1)
		local line, lastNL = 0, 0
		for p in before:gmatch("()\n") do
			line += 1
			lastNL = p
		end
		local seg = before:sub(lastNL + 1)
		return (utf8.len(seg) or #seg), line
	end

	local function updateCaret()
		local col, line = caretColLine()
		if not col then return end
		caret.Position = UDim2.fromOffset(PADX + col * charW - 1, PADY + line * lineH)
		caretT = os.clock()
	end

	local function ensureCaretVisible()
		local col, line = caretColLine()
		if not col then return end
		local cp, view = scroller.CanvasPosition, scroller.AbsoluteSize
		local x, y = PADX + col * charW, PADY + line * lineH
		local nx, ny = cp.X, cp.Y
		if y < cp.Y then ny = y elseif y + lineH + 8 > cp.Y + view.Y then ny = y + lineH + 8 - view.Y end
		if x < cp.X + 10 then nx = math.max(0, x - 30) elseif x + 30 > cp.X + view.X then nx = x + 30 - view.X end
		scroller.CanvasPosition = Vector2.new(nx, ny)
	end

	local function refreshHighlight()
		local txt = box.Text
		if #txt > 40000 then
			hl.Text = Lex.escape(txt)
		else
			hl.Text = Lex.highlight(txt, currentTheme.Syn)
		end
		local n = 1
		for _ in txt:gmatch("\n") do n += 1 end
		if n ~= lastLines then
			lastLines = n
			local t = table.create(n)
			for i = 1, n do t[i] = i end
			gutter.Text = table.concat(t, "\n")
		end
		if scripts[activeScript] then scripts[activeScript].code = txt end
	end

	local function setProgrammatic(text, cursor)
		expected = text
		prevText = text
		box.Text = text
		if cursor then box.CursorPosition = cursor end
		refreshHighlight()
	end

	local function hidePopup()
		popup.Visible = false
		suggestions = {}
	end

	local function startsWith(s, p) return s:sub(1, #p):lower() == p:lower() end

	local function getSuggestions(text, cursor)
		local before = text:sub(1, cursor - 1)
		local lineBefore = before:match("([^\n]*)$")
		if lineBefore:find("%-%-") then return {}, 0 end
		local dq = select(2, lineBefore:gsub('"', ""))
		local sq = select(2, lineBefore:gsub("'", ""))
		if dq % 2 == 1 or sq % 2 == 1 then return {}, 0 end

		local out = {}
		local obj, _, mprefix = before:match("([%a_][%w_]*)([%.:])([%w_]*)$")
		if obj and MEMBERS[obj] then
			for _, m in ipairs(MEMBERS[obj]) do
				if (mprefix == "" or startsWith(m, mprefix)) and m ~= mprefix then
					out[#out + 1] = { label = m, insert = m, kind = "member" }
					if #out >= 7 then break end
				end
			end
			return out, #mprefix
		end

		local prefix = before:match("[%a_][%w_]*$")
		if not prefix or #prefix < 2 then return {}, 0 end
		local afterDot = before:sub(#before - #prefix, #before - #prefix):find("[%.:]") ~= nil
		local seen = {}
		local function add(item, key)
			if #out < 6 and not seen[key] then
				seen[key] = true
				out[#out + 1] = item
			end
		end
		if not afterDot then
			for _, s in ipairs(SNIPPETS) do
				if startsWith(s.key, prefix) then add({ label = s.label, insert = s.insert, kind = "snippet" }, "s:" .. s.key) end
			end
			for _, k in ipairs(KEYWORD_LIST) do
				if k ~= prefix and startsWith(k, prefix) then add({ label = k, insert = k, kind = "keyword" }, "k:" .. k) end
			end
			for _, g in ipairs(GLOBAL_LIST) do
				if g ~= prefix and startsWith(g, prefix) then add({ label = g, insert = g, kind = "global" }, "g:" .. g) end
			end
		end
		local count = 0
		for w in text:gmatch("[%a_][%w_]*") do
			if #w >= 3 and w ~= prefix and not seen["w:" .. w] and startsWith(w, prefix) then
				add({ label = w, insert = w, kind = "word" }, "w:" .. w)
				seen["w:" .. w] = true
				count += 1
				if count >= 40 then break end
			end
		end
		return out, #prefix
	end

	local function acceptSuggestion(item)
		local text, cur = box.Text, box.CursorPosition
		if cur < 1 then return end
		local startPos = cur - suggestPrefixLen
		local before, after = text:sub(1, startPos - 1), text:sub(cur)
		local indent = (before:match("([^\n]*)$") or ""):match("^%s*") or ""
		local ins = item.insert:gsub("\n", "\n" .. indent)
		local marker = ins:find("|", 1, true)
		local newCur
		if marker then
			ins = ins:sub(1, marker - 1) .. ins:sub(marker + 1)
			newCur = startPos + marker - 1
		else
			newCur = startPos + #ins
		end
		setProgrammatic(before .. ins .. after, newCur)
		hidePopup()
		layout()
		ensureCaretVisible()
	end

	local function showPopup(list, plen)
		for _, c in ipairs(popup:GetChildren()) do
			if c:IsA("TextButton") then c:Destroy() end
		end
		suggestions, suggestPrefixLen = list, plen
		if #list == 0 then
			popup.Visible = false
			return
		end
		for i, it in ipairs(list) do
			local b = New("TextButton", { AutoButtonColor = false, BorderSizePixel = 0, Text = "", Size = UDim2.new(1, 0, 0, 22), BackgroundColor3 = i == 1 and T("Surface2") or T("Surface"), Parent = popup })
			corner(b, 4)
			New("TextLabel", { BackgroundTransparency = 1, Text = it.label, Font = F.Code, TextSize = 13, TextColor3 = T("Text"), TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -66, 1, 0), Parent = b })
			New("TextLabel", { BackgroundTransparency = 1, Text = it.kind, Font = F.Gotham, TextSize = 10, TextColor3 = T("Sub"), TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 0), Size = UDim2.fromOffset(54, 22), Parent = b })
			b.MouseButton1Down:Connect(function() acceptSuggestion(it) end)
		end
		local col, line = caretColLine()
		if col then
			local cp = scroller.CanvasPosition
			local hs = editorHolder.AbsoluteSize
			local px = math.clamp(41 + PADX + col * charW - cp.X, 4, math.max(4, hs.X - 226))
			local ph = #list * 22 + 6
			local py = PADY + (line + 1) * lineH - cp.Y + 2
			if py + ph > hs.Y then py = PADY + line * lineH - cp.Y - ph - 2 end
			popup.Position = UDim2.fromOffset(px, math.max(2, py))
		end
		popup.Visible = true
	end

	local function updateSuggestions()
		if not box:IsFocused() or box.CursorPosition < 1 then
			hidePopup()
			return
		end
		local list, plen = getSuggestions(box.Text, box.CursorPosition)
		if #list == 0 then hidePopup() else showPopup(list, plen) end
	end

	local PAIRS = { ["("] = ")", ["["] = "]", ["{"] = "}" }

	local function smartInsert(ch, new, cur)
		local before, after = new:sub(1, cur - 1), new:sub(cur)
		local nextCh = after:sub(1, 1)
		if ch == "\t" then
			if popup.Visible and #suggestions > 0 then
				local item = suggestions[1]
				setProgrammatic(new:sub(1, cur - 2) .. after, cur - 1)
				acceptSuggestion(item)
			else
				setProgrammatic(new:sub(1, cur - 2) .. "    " .. after, cur + 3)
				hidePopup()
			end
			return true
		elseif ch == "\n" then
			local prevLine = before:sub(1, -2):match("([^\n]*)$") or ""
			local indent = prevLine:match("^%s*") or ""
			local trimmed = prevLine:gsub("%s+$", "")
			local lineBal = Lex.balance(prevLine)
			local endsThen = trimmed:find("%f[%w_]then$") ~= nil
			local endsDo = trimmed:find("%f[%w_]do$") ~= nil
			local endsElse = trimmed:find("%f[%w_]else$") ~= nil
			local endsRepeat = trimmed:find("%f[%w_]repeat$") ~= nil
			local endsFunc = lineBal > 0 and trimmed:find("%)$") ~= nil
			local opensBlock = endsThen or endsDo or endsElse or endsRepeat or endsFunc or trimmed:sub(-1) == "{"
			local needsEnd = lineBal > 0 and (endsThen or endsDo or endsFunc) and Lex.balance(new) > 0
			if trimmed:sub(-1) == "{" and nextCh == "}" then
				setProgrammatic(before .. indent .. "    \n" .. indent .. after, cur + #indent + 4)
			elseif needsEnd then
				local ins = indent .. "    "
				local opens = select(2, prevLine:gsub("%(", ""))
				local closes = select(2, prevLine:gsub("%)", ""))
				local endWord = opens > closes and "end)" or "end"
				setProgrammatic(before .. ins .. "\n" .. indent .. endWord .. after, cur + #ins)
			else
				local ins = indent .. (opensBlock and "    " or "")
				setProgrammatic(before .. ins .. after, cur + #ins)
			end
			hidePopup()
			return true
		elseif ch == ")" or ch == "]" or ch == "}" then
			if nextCh == ch then
				setProgrammatic(new:sub(1, cur - 2) .. after, cur)
				return true
			end
		elseif PAIRS[ch] then
			setProgrammatic(before .. PAIRS[ch] .. after, cur)
			return true
		elseif ch == '"' or ch == "'" then
			if nextCh == ch then
				setProgrammatic(new:sub(1, cur - 2) .. after, cur)
				return true
			end
			local prevCh = before:sub(-2, -2)
			if not prevCh:find("[%w_\"']") and not nextCh:find("[%w_]") then
				setProgrammatic(before .. ch .. after, cur)
				return true
			end
		elseif ch:find("%a") then
			local curLine = before:match("([^\n]*)$") or ""
			local ind, word = curLine:match("^(%s+)(%a+)$")
			if ind and #ind >= 4 and (word == "end" or word == "else" or word == "until") then
				local lineStart = cur - #curLine
				setProgrammatic(new:sub(1, lineStart - 1) .. curLine:sub(5) .. after, cur - 4)
				return true
			end
		end
		return false
	end

	local function onTextChanged()
		local new = box.Text
		if new == expected then
			prevText = new
			refreshHighlight()
			return
		end
		local cur = box.CursorPosition
		local old = prevText
		local done = false
		if cur > 1 and #new == #old + 1 and new:sub(1, cur - 2) == old:sub(1, cur - 2) and new:sub(cur) == old:sub(cur - 1) then
			done = smartInsert(new:sub(cur - 1, cur - 1), new, cur)
		elseif new:find("\t", 1, true) and cur > 0 then
			local _, n = new:sub(1, cur - 1):gsub("\t", "")
			local fixed = new:gsub("\t", "    ")
			setProgrammatic(fixed, cur + 3 * n)
			done = true
		end
		if not done then
			prevText = box.Text
			refreshHighlight()
		end
		layout()
		updateCaret()
		ensureCaretVisible()
		updateSuggestions()
	end

	connect(box:GetPropertyChangedSignal("Text"), onTextChanged)
	connect(box:GetPropertyChangedSignal("TextBounds"), layout)
	connect(scroller:GetPropertyChangedSignal("AbsoluteSize"), layout)
	connect(box:GetPropertyChangedSignal("CursorPosition"), function()
		updateCaret()
		ensureCaretVisible()
		if popup.Visible then updateSuggestions() end
	end)
	connect(scroller:GetPropertyChangedSignal("CanvasPosition"), function()
		gutter.Position = UDim2.fromOffset(0, -scroller.CanvasPosition.Y)
	end)
	connect(box.Focused, function() updateCaret() end)
	connect(box.FocusLost, function()
		task.delay(0.2, function()
			if not box:IsFocused() then hidePopup() end
		end)
	end)
	connect(RunService.Heartbeat, function()
		caret.Visible = box:IsFocused() and ((os.clock() - caretT) % 1) < 0.6
	end)
	connect(UserInputService.InputBegan, function(input)
		if input.KeyCode == Enum.KeyCode.Escape and popup.Visible then hidePopup() end
	end)

	local tabButtons = {}
	local renderTabs

	local function saveCurrent()
		if scripts[activeScript] then scripts[activeScript].code = box.Text end
	end
	local function loadActive()
		setProgrammatic(scripts[activeScript].code, nil)
		scroller.CanvasPosition = Vector2.new(0, 0)
		layout()
		hidePopup()
	end
	local function switchScript(i)
		if i == activeScript then return end
		saveCurrent()
		activeScript = i
		loadActive()
		renderTabs()
	end
	local function newScript()
		saveCurrent()
		local used = {}
		for _, s in ipairs(scripts) do used[s.name] = true end
		local n = 1
		while used["Script " .. n] do n += 1 end
		scripts[#scripts + 1] = { name = "Script " .. n, code = "" }
		activeScript = #scripts
		loadActive()
		renderTabs()
	end
	local function deleteScript(i)
		if #scripts == 1 then
			scripts[1] = { name = "Script 1", code = "" }
			activeScript = 1
		else
			table.remove(scripts, i)
			if activeScript > #scripts then activeScript = #scripts end
			if i < activeScript then activeScript -= 1 end
		end
		loadActive()
		renderTabs()
	end
	local function renameScript(i)
		prompt("Rename Tab", scripts[i].name, "Rename", function(v)
			scripts[i].name = v:sub(1, 24)
			renderTabs()
		end)
	end
	local function uniqueName(base)
		base = base:sub(1, 24)
		local used = {}
		for _, s in ipairs(scripts) do used[s.name] = true end
		if not used[base] then return base end
		local n = 2
		while used[base:sub(1, 20) .. " " .. n] do n += 1 end
		return base:sub(1, 20) .. " " .. n
	end
	local function duplicateScript(i)
		saveCurrent()
		local src = scripts[i]
		if not src then return end
		table.insert(scripts, i + 1, { name = uniqueName(src.name:sub(1, 18) .. " Copy"), code = src.code })
		activeScript = i + 1
		loadActive()
		renderTabs()
	end

	local function clearEditor()
		setProgrammatic("", nil)
		if box:IsFocused() then box.CursorPosition = 1 end
		layout()
		hidePopup()
	end
	local function copyScript(i)
		saveCurrent()
		local s = scripts[i]
		if not s then return end
		if copy(s.code) then notify("Copied \"" .. s.name .. "\" to the clipboard.", "success")
		else notify("Your executor doesn't support clipboard access.", "error") end
	end

