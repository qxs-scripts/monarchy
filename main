local Lex = {}
do
	local KW, CONST, BUILTIN = Set(KEYWORD_LIST), Set({ "nil", "true", "false" }), Set(GLOBAL_LIST)
	local COLORMAP = { comment = "Comment", string = "String", number = "Number", kw = "Keyword", const = "Constant", builtin = "Builtin", func = "Function", prop = "Property" }

	local function esc(s)
		s = s:gsub("&", "&amp;")
		s = s:gsub("<", "&lt;")
		s = s:gsub(">", "&gt;")
		return s
	end

	local function tokenize(src)
		local toks, n = {}, 0
		local i, len = 1, #src
		local pText = nil
		while i <= len do
			local c = src:sub(i, i)
			local ty, e
			if c:find("^%s") then
				local _, ee = src:find("^%s+", i)
				e = ee
				ty = "ws"
			elseif c == "-" and src:sub(i + 1, i + 1) == "-" then
				local eq = src:match("^%-%-%[(=*)%[", i)
				if eq then
					local _, ce = src:find("]" .. eq .. "]", i + 4 + #eq, true)
					e = ce or len
				else
					local nl = src:find("\n", i, true)
					e = (nl or len + 1) - 1
				end
				ty = "comment"
			elseif c == '"' or c == "'" then
				local j = i + 1
				while j <= len do
					local d = src:sub(j, j)
					if d == "\\" then
						j += 2
					elseif d == c then
						break
					elseif d == "\n" then
						j -= 1
						break
					else
						j += 1
					end
				end
				e = math.min(j, len)
				ty = "string"
			elseif c == "[" and src:find("^%[=*%[", i) then
				local eq = src:match("^%[(=*)%[", i)
				local _, ce = src:find("]" .. eq .. "]", i + 2 + #eq, true)
				e = ce or len
				ty = "string"
			elseif c:find("^%d") or (c == "." and src:find("^%.%d", i)) then
				local _, ee = src:find("^0[xX]%x+", i)
				if not ee then _, ee = src:find("^%d+%.?%d*[eE][%+%-]?%d+", i) end
				if not ee then _, ee = src:find("^%d+%.?%d*", i) end
				if not ee then _, ee = src:find("^%.%d+", i) end
				e = ee or i
				ty = "number"
			elseif c:find("^[%a_]") then
				local _, ee = src:find("^[%a_][%w_]*", i)
				e = ee
				local word = src:sub(i, e)
				if KW[word] then
					ty = "kw"
				elseif CONST[word] then
					ty = "const"
				else
					local nextc = src:match("^%s*(.)", e + 1)
					if pText == "." or pText == ":" then
						ty = (nextc == "(") and "func" or "prop"
					elseif pText == "function" then
						ty = "func"
					elseif BUILTIN[word] then
						ty = "builtin"
					elseif nextc == "(" then
						ty = "func"
					else
						ty = "ident"
					end
				end
			else
				if c == "." and src:sub(i, i + 2) == "..." then
					e = i + 2
				elseif c == "." and src:sub(i + 1, i + 1) == "." then
					e = i + 1
				else
					e = i
				end
				ty = "punct"
			end
			local piece = src:sub(i, e)
			n += 1
			toks[n] = { ty, piece }
			if ty ~= "ws" and ty ~= "comment" then pText = piece end
			i = e + 1
		end
		return toks
	end

	function Lex.highlight(src, syn)
		local out, n = {}, 0
		for _, t in ipairs(tokenize(src)) do
			local key = COLORMAP[t[1]]
			local color = key and syn[key]
			n += 1
			if color then
				out[n] = '<font color="' .. color .. '">' .. esc(t[2]) .. "</font>"
			else
				out[n] = esc(t[2])
			end
		end
		return table.concat(out)
	end

	function Lex.escape(s) return esc(s) end

	function Lex.balance(src)
		local bal = 0
		for _, t in ipairs(tokenize(src)) do
			if t[1] == "kw" then
				local w = t[2]
				if w == "if" or w == "do" or w == "function" or w == "repeat" then
					bal += 1
				elseif w == "end" or w == "until" then
					bal -= 1
				end
			end
		end
		return bal
	end
end

