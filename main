local Pages, PageOrder = {}, { "Home", "Executor", "Script Hub", "Misc", "Settings", "Credits" }
local function newPage(name, scroll)
	local p
	if scroll then
		p = New("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 3, ScrollingDirection = Enum.ScrollingDirection.Y, Visible = false, Parent = content })
		bind(p, "ScrollBarImageColor3", "Border")
		Pad(p, 14, 12, 17, 14)
		New("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = p })
	else
		p = New("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Visible = false, Parent = content })
		Pad(p, 14, 12, 14, 12)
	end
	p.Name = name
	Pages[name] = p
	return p
end
