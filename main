	sidePlus.MouseButton1Click:Connect(newScript)
	newBtn.MouseButton1Click:Connect(newScript)
	delBtn.MouseButton1Click:Connect(function() deleteScript(activeScript) end)
	copyBtn.MouseButton1Click:Connect(function() copyScript(activeScript) end)

