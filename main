local toastHolder = New("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -18, 1, -18), Size = UDim2.fromOffset(290, 400), ZIndex = 70, Parent = gui })
New("UIListLayout", { VerticalAlignment = Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Right, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = toastHolder })

local function notify(message, kind)
	local col = kind == "error" and T("Bad") or (kind == "success" and T("Good") or T("Accent"))
	local toast = New("Frame", { BorderSizePixel = 0, BackgroundColor3 = T("Surface"), BackgroundTransparency = 1, Size = UDim2.fromOffset(280, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = toastHolder })
	corner(toast, 8)
	local st = New("UIStroke", { Color = col, Thickness = 1, Transparency = 1, Parent = toast })
	Pad(toast, 12, 9, 12, 9)
	local lbl = New("TextLabel", {
		BackgroundTransparency = 1, Text = tostring(message), Font = F.Gotham, TextSize = 13, TextColor3 = T("Text"), TextTransparency = 1,
		TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = toast,
	})
	tween(toast, { BackgroundTransparency = 0.05 }, 0.2)
	tween(st, { Transparency = 0 }, 0.2)
	tween(lbl, { TextTransparency = 0 }, 0.2)
	task.delay(3.5, function()
		if not toast.Parent then return end
		tween(toast, { BackgroundTransparency = 1 }, 0.25)
		tween(st, { Transparency = 1 }, 0.25)
		tween(lbl, { TextTransparency = 1 }, 0.25)
		task.wait(0.3)
		toast:Destroy()
	end)
end

local menuObjs = {}
local function closeMenu()
	for _, o in ipairs(menuObjs) do o:Destroy() end
	menuObjs = {}
end

local function showMenu(items)
	closeMenu()
	local mp = UserInputService:GetMouseLocation()
	local vp = gui.AbsoluteSize
	local w, h = 150, #items * 28 + 8
	local catcher = New("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 50, AutoButtonColor = false, Parent = gui })

	catcher.InputBegan:Connect(function(i)
		local t = i.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 or t == Enum.UserInputType.Touch then
			closeMenu()
		end
	end)
	local menu = New("Frame", {
		BorderSizePixel = 0, BackgroundColor3 = T("Surface"), Size = UDim2.fromOffset(w, h), ZIndex = 51,
		Position = UDim2.fromOffset(math.min(mp.X, vp.X - w - 6), math.min(mp.Y, vp.Y - h - 6)), Active = true, Parent = gui,
	})
	corner(menu, 8)
	New("UIStroke", { Color = T("Border"), Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = menu })
	Pad(menu, 4, 4, 4, 4)
	New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Parent = menu })
	for _, it in ipairs(items) do
		local b = New("TextButton", {
			AutoButtonColor = false, BorderSizePixel = 0, BackgroundTransparency = 1, BackgroundColor3 = T("Surface2"), Text = it[1],
			Font = F.GothamMedium, TextSize = 13, TextColor3 = it[3] and T("Bad") or T("Text"), TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, 0, 0, 28), Parent = menu,
		})
		Pad(b, 10, 0, 10, 0)
		corner(b, 5)
		b.MouseEnter:Connect(function() b.BackgroundTransparency = 0 end)
		b.MouseLeave:Connect(function() b.BackgroundTransparency = 1 end)
		b.MouseButton1Click:Connect(function()
			closeMenu()
			it[2]()
		end)
	end
	menuObjs = { catcher, menu }
end

local modalOpen = false
local function prompt(title, default, confirmText, cb)
	modalOpen = true
	closeMenu()
	local overlay = New("TextButton", { Text = "", AutoButtonColor = false, BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.5, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 60, Parent = gui })
	local card = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(310, 134), BorderSizePixel = 0, BackgroundColor3 = T("Surface"), Active = true, Parent = overlay })
	corner(card, 10)
	New("UIStroke", { Color = T("Border"), Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = card })
	New("TextLabel", { BackgroundTransparency = 1, Text = title, Font = F.GothamBold, TextSize = 14, TextColor3 = T("Text"), TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(16, 12), Size = UDim2.new(1, -32, 0, 20), Parent = card })
	local box = New("TextBox", { BorderSizePixel = 0, ClearTextOnFocus = false, Text = default or "", Font = F.Gotham, TextSize = 13, TextColor3 = T("Text"), BackgroundColor3 = T("Surface2"), TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(16, 42), Size = UDim2.new(1, -32, 0, 32), Parent = card })
	corner(box, 6)
	Pad(box, 8, 0, 8, 0)
	New("UIStroke", { Color = T("Border"), Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = box })
	local function close()
		modalOpen = false
		overlay:Destroy()
	end
	local function confirm()
		local v = trim(box.Text)
		close()
		if v ~= "" then cb(v) end
	end
	local ok = New("TextButton", { AutoButtonColor = false, BorderSizePixel = 0, Text = confirmText or "OK", Font = F.GothamMedium, TextSize = 13, TextColor3 = T("OnAccent"), BackgroundColor3 = T("Accent"), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -14), Size = UDim2.fromOffset(84, 28), Parent = card })
	corner(ok, 6)
	local cancel = New("TextButton", { AutoButtonColor = false, BorderSizePixel = 0, Text = "Cancel", Font = F.GothamMedium, TextSize = 13, TextColor3 = T("Text"), BackgroundColor3 = T("Surface2"), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -108, 1, -14), Size = UDim2.fromOffset(84, 28), Parent = card })
	corner(cancel, 6)
	ok.MouseButton1Click:Connect(confirm)
	cancel.MouseButton1Click:Connect(close)
	overlay.MouseButton1Click:Connect(close)
	box.FocusLost:Connect(function(enter) if enter then confirm() end end)
	task.defer(function() box:CaptureFocus() end)
end

local function Set(list)
	local t = {}
	for _, v in ipairs(list) do t[v] = true end
	return t
end

